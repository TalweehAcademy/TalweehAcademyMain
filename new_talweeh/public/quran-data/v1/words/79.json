"],["يَخْشَىٰٓ","fears","yakhshā"]],[["ءَأَنتُمْ","Are you","a-antum"],["أَشَدُّ","a more difficult","ashaddu"],["خَلْقًا","creation","khalqan"],["أَمِ","or","ami"],["ٱلسَّمَآءُ ۚ","the heaven","l-samāu"],["بَنَىٰهَا","He constructed it","banāhā"]],[["رَفَعَ","He raised","rafaʿa"],["سَمْكَهَا","its ceiling","samkahā"],["فَسَوَّىٰهَا","and proportioned it","fasawwāhā"]],[["وَأَغْطَشَ","And He darkened","wa-aghṭasha"],["لَيْلَهَا","its night","laylahā"],["وَأَخْرَجَ","and brought out","wa-akhraja"],["ضُحَىٰهَا","its brightness","ḍuḥāhā"]],[["وَٱلْأَرْضَ","And the earth","wal-arḍa"],["بَعْدَ","after","baʿda"],["ذَٰلِكَ","that","dhālika"],["دَحَىٰهَآ","He spread it","daḥāhā"]],[["أَخْرَجَ","He brought forth","akhraja"],["مِنْهَا","from it","min'hā"],["مَآءَهَا","its water","māahā"],["وَمَرْعَىٰهَا","and its pasture","wamarʿāhā"]],[["وَٱلْجِبَالَ","And the mountains","wal-jibāla"],["أَرْسَىٰهَا","He made them firm","arsāhā"]],[["مَتَـٰعًا","(As) a provision","matāʿan"],["لَّكُمْ","for you","lakum"],["وَلِأَنْعَـٰمِكُمْ","and for your cattle","wali-anʿāmikum"]],[["فَإِذَا","But when","fa-idhā"],["جَآءَتِ","comes","jāati"],["ٱلطَّآمَّةُ","the Overwhelming Calamity","l-ṭāmatu"],["ٱلْكُبْرَىٰ","the great","l-kub'rā"]],[["يَوْمَ","(The) Day","yawma"],["يَتَذَكَّرُ","will remember","yatadhakkaru"],["ٱلْإِنسَـٰنُ","man","l-insānu"],["مَا","what","mā"],["سَعَىٰ","he strove (for)","saʿā"]],[["وَبُرِّزَتِ","And will be made manifest","waburrizati"],["ٱلْجَحِيمُ","the Hellfire","l-jaḥīmu"],["لِمَن","to (him) who","liman"],["يَرَىٰ","sees","yarā"]],[["فَأَمَّا","Then as for","fa-ammā"],["مَن","(him) who","man"],["طَغَىٰ","transgressed","ṭaghā"]],[["وَءَاثَرَ","And preferred","waāthara"],["ٱلْحَيَوٰةَ","the life","l-ḥayata"],["ٱلدُّنْيَا","(of) the world","l-dun'yā"]],[["فَإِنَّ","Then indeed","fa-inna"],["ٱلْجَحِيمَ","the Hellfire","l-jaḥīma"],["هِىَ","it","hiya"],["ٱلْمَأْوَىٰ","(is) the refuge","l-mawā"]],[["وَأَمَّا","But as for","wa-ammā"],["مَنْ","(him) who","man"],["خَافَ