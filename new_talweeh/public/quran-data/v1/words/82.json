er you","ʿalaykum"],["لَحَـٰفِظِينَ","(are) surely guardians","laḥāfiẓīna"]],[["كِرَامًا","Noble","kirāman"],["كَـٰتِبِينَ","recording","kātibīna"]],[["يَعْلَمُونَ","They know","yaʿlamūna"],["مَا","whatever","mā"],["تَفْعَلُونَ","you do","tafʿalūna"]],[["إِنَّ","Indeed","inna"],["ٱلْأَبْرَارَ","the righteous","l-abrāra"],["لَفِى","(will be) surely in","lafī"],["نَعِيمٍ","bliss","naʿīmin"]],[["وَإِنَّ","And indeed","wa-inna"],["ٱلْفُجَّارَ","the wicked","l-fujāra"],["لَفِى","(will be) surely in","lafī"],["جَحِيمٍ","Hellfire","jaḥīmin"]],[["يَصْلَوْنَهَا","They will burn (in) it","yaṣlawnahā"],["يَوْمَ","(on the) Day","yawma"],["ٱلدِّينِ","(of) the Judgment","l-dīni"]],[["وَمَا","And not","wamā"],["هُمْ","they","hum"],["عَنْهَا","from it","ʿanhā"],["بِغَآئِبِينَ","(will be) absent","bighāibīna"]],[["وَمَآ","And what","wamā"],["أَدْرَىٰكَ","can make you know","adrāka"],["مَا","what","mā"],["يَوْمُ","(is the) Day","yawmu"],["ٱلدِّينِ","(of) the Judgment","l-dīni"]],[["ثُمَّ","Then","thumma"],["مَآ","what","mā"],["أَدْرَىٰكَ","can make you know","adrāka"],["مَا","what","mā"],["يَوْمُ","(is the) Day","yawmu"],["ٱلدِّينِ","(of) the Judgment","l-dīni"]],[["يَوْمَ","(The) Day","yawma"],["لَا","not","lā"],["تَمْلِكُ","will have power","tamliku"],["نَفْسٌ","a soul","nafsun"],["لِّنَفْسٍ","for a soul","linafsin"],["شَيْـًٔا ۖ","anything","shayan"],["وَٱلْأَمْرُ","and the Command","wal-amru"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["لِّلَّهِ","(will be) with Allah","lillahi"]]]}