hatever","ayyi","اَیِّ"],["صُورَةٍ","form","ṣūratin","صُوْرَةٍ"],["مَّا","what","mā","مَّا"],["شَآءَ","He willed","shāa","شَآءَ"],["رَكَّبَكَ","He assembled you","rakkabaka","رَكَّبَكَ"]],[["كَلَّا","Nay","kallā","كَلَّا"],["بَلْ","But","bal","بَلْ"],["تُكَذِّبُونَ","you deny","tukadhibūna","تُكَذِّبُوْنَ"],["بِٱلدِّينِ","the Judgment","bil-dīni","بِالدِّیْنِ"]],[["وَإِنَّ","And indeed","wa-inna","وَاِنَّ"],["عَلَيْكُمْ","over you","ʿalaykum","عَلَیْكُمْ"],["لَحَـٰفِظِينَ","(are) surely guardians","laḥāfiẓīna","لَحٰفِظِیْنَ"]],[["كِرَامًا","Noble","kirāman","كِرَامًا"],["كَـٰتِبِينَ","recording","kātibīna","كَاتِبِیْنَ"]],[["يَعْلَمُونَ","They know","yaʿlamūna","یَعْلَمُوْنَ"],["مَا","whatever","mā","مَا"],["تَفْعَلُونَ","you do","tafʿalūna","تَفْعَلُوْنَ"]],[["إِنَّ","Indeed","inna","اِنَّ"],["ٱلْأَبْرَارَ","the righteous","l-abrāra","الْاَبْرَارَ"],["لَفِى","(will be) surely in","lafī","لَفِیْ"],["نَعِيمٍ","bliss","naʿīmin","نَعِیْمٍ"]],[["وَإِنَّ","And indeed","wa-inna","وَاِنَّ"],["ٱلْفُجَّارَ","the wicked","l-fujāra","الْفُجَّارَ"],["لَفِى","(will be) surely in","lafī","لَفِیْ"],["جَحِيمٍ","Hellfire","jaḥīmin","جَحِیْمٍ"]],[["يَصْلَوْنَهَا","They will burn (in) it","yaṣlawnahā","یَّصْلَوْنَهَا"],["يَوْمَ","(on the) Day","yawma","یَوْمَ"],["ٱلدِّينِ","(of) the Judgment","l-dīni","الدِّیْنِ"]],[["وَمَا","And not","wamā","وَمَا"],["هُمْ","they","hum","هُمْ"],["عَنْهَا","from it","ʿanhā","عَنْهَا"],["بِغَآئِبِينَ","(will be) absent","bighāibīna","بِغَآىِٕبِیْنَ"]],[["وَمَآ","And what","wamā","وَمَاۤ"],["أَدْرَىٰكَ","can make you know","adrāka","اَدْرٰىكَ"],["مَا","what","mā","مَا"],["يَوْمُ","(is the) Day","yawmu","یَوْمُ"],["ٱلدِّينِ","(of) the Judgment","l-dīni","الدِّیْنِ"]],[["ثُمَّ","Then","thumma","ثُمَّ"],["مَآ","what","mā","مَاۤ"],["أَدْرَىٰكَ","can make you know","adrāka","اَدْرٰىكَ"],["مَا","what","mā","مَا"],["يَوْمُ","(is the) Day","yawmu","یَوْمُ"],["ٱلدِّينِ","(of) the Judgment","l-dīni","الدِّیْنِ"]],[["يَوْمَ","(The) Day","yawma","یَوْمَ"],["لَا","not","lā","لَا"],["تَمْلِكُ","will have power","tamliku","تَمْلِكُ"],["نَفْسٌ","a soul","nafsun","نَفْسٌ"],["لِّنَفْسٍ","for a soul","linafsin","لِّنَفْسٍ"],["شَيْـًٔا ۖ","anything","shayan","شَیْـًٔا ؕ"],["وَٱلْأَمْرُ","and the Command","wal-amru","وَالْاَمْرُ"],["يَوْمَئِذٍ","that Day","yawma-idhin","یَوْمَىِٕذٍ"],["لِّلَّهِ","(will be) with Allah","lillahi","لِّلّٰهِ"]]]}