Only","innamā"],["أَنَا۠","I am","anā"],["بَشَرٌ","a man","basharun"],["مِّثْلُكُمْ","like you","mith'lukum"],["يُوحَىٰٓ","it is revealed","yūḥā"],["إِلَىَّ","to me","ilayya"],["أَنَّمَآ","that","annamā"],["إِلَـٰهُكُمْ","your god","ilāhukum"],["إِلَـٰهٌ","(is) God","ilāhun"],["وَٰحِدٌ","One","wāḥidun"],["فَٱسْتَقِيمُوٓا۟","so take a Straight Path","fa-is'taqīmū"],["إِلَيْهِ","to Him","ilayhi"],["وَٱسْتَغْفِرُوهُ ۗ","and ask His forgiveness","wa-is'taghfirūhu"],["وَوَيْلٌ","And woe","wawaylun"],["لِّلْمُشْرِكِينَ","to the polytheists","lil'mush'rikīna"]],[["ٱلَّذِينَ","Those who","alladhīna"],["لَا","(do) not","lā"],["يُؤْتُونَ","give","yu'tūna"],["ٱلزَّكَوٰةَ","the zakah","l-zakata"],["وَهُم","and they","wahum"],["بِٱلْـَٔاخِرَةِ","in the Hereafter","bil-ākhirati"],["هُمْ","they","hum"],["كَـٰفِرُونَ","(are) disbelievers","kāfirūna"]],[["إِنَّ","Indeed","inna"],["ٱلَّذِينَ","those who","alladhīna"],["ءَامَنُوا۟","believe","āmanū"],["وَعَمِلُوا۟","and do","waʿamilū"],["ٱلصَّـٰلِحَـٰتِ","righteous deeds","l-ṣāliḥāti"],["لَهُمْ","for them","lahum"],["أَجْرٌ","(is) a reward","ajrun"],["غَيْرُ","never ending","ghayru"],["مَمْنُونٍ","never ending","mamnūnin"]],[["۞ قُلْ","Say","qul"],["أَئِنَّكُمْ","Do you indeed","a-innakum"],["لَتَكْفُرُونَ","[surely] disbelieve","latakfurūna"],["بِٱلَّذِى","in the One Who","bi-alladhī"],["خَلَقَ","created","khalaqa"],["ٱلْأَرْضَ","the earth","l-arḍa"],["فِى","in","fī"],["يَوْمَيْنِ","two periods","yawmayni"],["وَتَجْعَلُونَ","and you set up","watajʿalūna"],["لَهُۥٓ","with Him","lahu"],["أَندَادًا ۚ","rivals","andādan"],["ذَٰلِكَ","That","dhālika"],["رَبُّ","(is the) Lord","rabbu"],["ٱلْعَـٰلَمِينَ","(of) the worlds","l-ʿālamīna"]],[["وَجَعَلَ","And He placed","wajaʿala"],["فِيهَا","therein","fīhā"],["رَوَٰسِىَ","firmly-set mountains","rawāsiya"],["مِن","above it","min"],["فَوْقِهَا","above it","fawqihā"],["وَبَـٰرَكَ","and He blessed","wabāraka"],["فِيهَا","therein","fīhā"],["وَقَدَّرَ","and determined","waqaddara"],["فِيهَآ","there