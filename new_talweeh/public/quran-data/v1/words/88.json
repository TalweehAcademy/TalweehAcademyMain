"]],[["فِيهَا","Therein","fīhā"],["عَيْنٌ","(will be) a spring","ʿaynun"],["جَارِيَةٌ","flowing","jāriyatun"]],[["فِيهَا","Therein","fīhā"],["سُرُرٌ","(will be) thrones","sururun"],["مَّرْفُوعَةٌ","raised high","marfūʿatun"]],[["وَأَكْوَابٌ","And cups","wa-akwābun"],["مَّوْضُوعَةٌ","put in place","mawḍūʿatun"]],[["وَنَمَارِقُ","And cushions","wanamāriqu"],["مَصْفُوفَةٌ","lined up","maṣfūfatun"]],[["وَزَرَابِىُّ","And carpets","wazarābiyyu"],["مَبْثُوثَةٌ","spread out","mabthūthatun"]],[["أَفَلَا","Then do not","afalā"],["يَنظُرُونَ","they look","yanẓurūna"],["إِلَى","towards","ilā"],["ٱلْإِبِلِ","the camels","l-ibili"],["كَيْفَ","how","kayfa"],["خُلِقَتْ","they are created","khuliqat"]],[["وَإِلَى","And towards","wa-ilā"],["ٱلسَّمَآءِ","the sky","l-samāi"],["كَيْفَ","how","kayfa"],["رُفِعَتْ","it is raised","rufiʿat"]],[["وَإِلَى","And towards","wa-ilā"],["ٱلْجِبَالِ","the mountains","l-jibāli"],["كَيْفَ","how","kayfa"],["نُصِبَتْ","they are fixed","nuṣibat"]],[["وَإِلَى","And towards","wa-ilā"],["ٱلْأَرْضِ","the earth","l-arḍi"],["كَيْفَ","how","kayfa"],["سُطِحَتْ","it is spread out","suṭiḥat"]],[["فَذَكِّرْ","So remind","fadhakkir"],["إِنَّمَآ","only","innamā"],["أَنتَ","you","anta"],["مُذَكِّرٌ","(are) a reminder","mudhakkirun"]],[["لَّسْتَ","You are not","lasta"],["عَلَيْهِم","over them","ʿalayhim"],["بِمُصَيْطِرٍ","a controller","bimuṣayṭirin"]],[["إِلَّا","But","illā"],["مَن","whoever","man"],["تَوَلَّىٰ","turns away","tawallā"],["وَكَفَرَ","and disbelieves","wakafara"]],[["فَيُعَذِّبُهُ","Then will punish him","fayuʿadhibuhu"],["ٱللَّهُ","Allah","l-lahu"],["ٱلْعَذَابَ","(with) the punishment","l-ʿadhāba"],["ٱلْأَكْبَرَ","greatest","l-akbara"]],[["إِنَّ","Indeed","inna"],["إِلَيْنَآ","to Us","ilaynā"],["إِيَابَهُمْ","(will be) their return","iyābahum"]],[["ثُمَّ","Then","thumma"],["إِنَّ","indeed","inna"],["عَلَيْنَا","upon Us","ʿalaynā"],["حِسَابَهُم","(is) their account","ḥisābahum"]]]}