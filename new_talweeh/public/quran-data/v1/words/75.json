ُ","[the] man","l-insānu"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["أَيْنَ","Where","ayna"],["ٱلْمَفَرُّ","(is) the escape","l-mafaru"]],[["كَلَّا","By no means","kallā"],["لَا","(There is) no","lā"],["وَزَرَ","refuge","wazara"]],[["إِلَىٰ","To","ilā"],["رَبِّكَ","your Lord","rabbika"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["ٱلْمُسْتَقَرُّ","(is) the place of rest","l-mus'taqaru"]],[["يُنَبَّؤُا۟","Will be informed","yunabba-u"],["ٱلْإِنسَـٰنُ","[the] man","l-insānu"],["يَوْمَئِذٍۭ","that Day","yawma-idhin"],["بِمَا","of what","bimā"],["قَدَّمَ","he sent forth","qaddama"],["وَأَخَّرَ","and kept back","wa-akhara"]],[["بَلِ","Nay","bali"],["ٱلْإِنسَـٰنُ","[The] man","l-insānu"],["عَلَىٰ","against","ʿalā"],["نَفْسِهِۦ","himself","nafsihi"],["بَصِيرَةٌ","(will be) a witness","baṣīratun"]],[["وَلَوْ","Even if","walaw"],["أَلْقَىٰ","he presents","alqā"],["مَعَاذِيرَهُۥ","his excuses","maʿādhīrahu"]],[["لَا","Not","lā"],["تُحَرِّكْ","move","tuḥarrik"],["بِهِۦ","with it","bihi"],["لِسَانَكَ","your tongue","lisānaka"],["لِتَعْجَلَ","to hasten","litaʿjala"],["بِهِۦٓ","with it","bihi"]],[["إِنَّ","Indeed","inna"],["عَلَيْنَا","upon Us","ʿalaynā"],["جَمْعَهُۥ","(is) its collection","jamʿahu"],["وَقُرْءَانَهُۥ","and its recitation","waqur'ānahu"]],[["فَإِذَا","And when","fa-idhā"],["قَرَأْنَـٰهُ","We have recited it","qaranāhu"],["فَٱتَّبِعْ","then follow","fa-ittabiʿ"],["قُرْءَانَهُۥ","its recitation","qur'ānahu"]],[["ثُمَّ","Then","thumma"],["إِنَّ","indeed","inna"],["عَلَيْنَا","upon Us","ʿalaynā"],["بَيَانَهُۥ","(is) its explanation","bayānahu"]],[["كَلَّا","No","kallā"],["بَلْ","But","bal"],["تُحِبُّونَ","you love","tuḥibbūna"],["ٱلْعَاجِلَةَ","the immediate","l-ʿājilata"]],[["وَتَذَرُونَ","And leave","watadharūna"],["ٱلْـَٔاخِرَةَ","the Hereafter","l-ākhirata"]],[["وُجُوهٌ","Faces","wujūhun"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["نَّاضِرَةٌ","(will be) radiant","nāḍiratun"]],[["إِلَىٰ","Towards","ilā"],["رَبِّهَا","their Lord","rabbihā"],["نَاظِرَةٌ","looking","nāẓiratun"]],[["وَوُجُوهٌ","And faces","wawujūhun"],["يَوْمَئِذٍۭ","that Day","yawma-idhin"],["بَاسِرَةٌ","(will be) distorted","bāsiratun"]],[["تَظُنُّ","Thinking","taẓunnu"],["أَن","that","an"],["يُفْعَلَ","will be done","yuf'ʿala"],["بِهَا","to them","bihā"],["فَاقِرَةٌ","backbreaking","fāqiratun"]],[["كَلَّآ","No","kallā"],["إِذَا","When","idhā"],["بَلَغَتِ","it reaches","balaghati"],["ٱلتَّرَاقِىَ","the collar bones","l-tarāqiya"]],[["وَقِيلَ","And it is said","waqīla"],["مَنْ ۜ","Who","man"],["رَاقٍ","(will) cure","rāqin"]],[["وَظَنَّ","And he is certain","waẓanna"],["أَنَّهُ","that it","annahu"],["ٱلْفِرَاقُ","(is) the parting","l-firāqu"]],[["وَٱلْتَفَّتِ","And is wound","wal-tafati"],["ٱلسَّاقُ","the leg","l-sāqu"],["بِٱلسَّاقِ","about the leg","bil-sāqi"]],[["إِلَىٰ","To","ilā"],["رَبِّكَ","your Lord","rabbika"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["ٱلْمَسَاقُ","(will be) the driving","l-masāqu"]],[["فَلَا","And not","falā"],["صَدَّقَ","he accepted (the) truth","ṣaddaqa"],["وَلَا","and not","walā"],["صَلَّىٰ","he prayed","ṣallā"]],[["وَلَـٰكِن","But","walākin"],["كَذَّبَ","he denied","kadhaba"],["وَتَوَلَّىٰ","and turned away","watawallā"]],[["ثُمَّ","Then","thumma"],["ذَهَبَ","he went","dhahaba"],["إِلَىٰٓ","to","ilā"],["أَهْلِهِۦ","his family","ahlihi"],["يَتَمَطَّىٰٓ","swaggering","yatamaṭṭā"]],[["أَوْلَىٰ","Woe","awlā"],["لَكَ","to you","laka"],["فَأَوْلَىٰ","and woe","fa-awlā"]],[["ثُمَّ","Then","thumma"],["أَوْلَىٰ","woe","awlā"],["لَكَ","to you","laka"],["فَأَوْلَىٰٓ","and woe","fa-awlā"]],[["أَيَحْسَبُ","Does think","ayaḥsabu"],["ٱلْإِنسَـٰنُ","man","l-insānu"],["أَن","that","an"],["يُتْرَكَ","he will be left","yut'raka"],["سُدًى","neglected","sudan"]],[["أَلَمْ","Was not","alam"],["يَكُ","he","yaku"],["نُطْفَةً","a semen-drop","nuṭ'fatan"],["مِّن","of","min"],["مَّنِىٍّ","semen","maniyyin"],["يُمْنَىٰ","emitted","yum'nā"]],[["ثُمَّ","Then","thumma"],["كَانَ","he was","kāna"],["عَلَقَةً","a clinging substance","ʿalaqatan"],["فَخَلَقَ","then He created","fakhalaqa"],["فَسَوَّىٰ","and proportioned","fasawwā"]],[["فَجَعَلَ","Then made","fajaʿala"],["مِنْهُ","of him","min'hu"],["ٱلزَّوْجَيْنِ","two kinds","l-zawjayni"],["ٱلذَّكَرَ","(the) male","l-dhakara"],["وَٱلْأُنثَىٰٓ","and the female","wal-unthā"]],[["أَلَيْسَ","Is not","alaysa"],["ذَٰلِكَ","[that]","dhālika"],["بِقَـٰدِرٍ","(He) Able","biqādirin"],["عَلَىٰٓ","[over]","ʿalā"],["أَن","to","an"],["يُحْـِۧىَ","give life","yuḥ'yiya"],["ٱلْمَوْتَىٰ","(to) the dead","l-mawtā"]]]}