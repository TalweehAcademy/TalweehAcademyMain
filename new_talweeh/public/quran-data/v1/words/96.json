uidance","l-hudā"]],[["أَوْ","Or","aw"],["أَمَرَ","he enjoins","amara"],["بِٱلتَّقْوَىٰٓ","[of the] righteousness","bil-taqwā"]],[["أَرَءَيْتَ","Have you seen","ara-ayta"],["إِن","if","in"],["كَذَّبَ","he denies","kadhaba"],["وَتَوَلَّىٰٓ","and turns away","watawallā"]],[["أَلَمْ","Does not","alam"],["يَعْلَم","he know","yaʿlam"],["بِأَنَّ","that","bi-anna"],["ٱللَّهَ","Allah","l-laha"],["يَرَىٰ","sees","yarā"]],[["كَلَّا","Nay","kallā"],["لَئِن","If","la-in"],["لَّمْ","not","lam"],["يَنتَهِ","he desists","yantahi"],["لَنَسْفَعًۢا","surely We will drag him","lanasfaʿan"],["بِٱلنَّاصِيَةِ","by the forelock","bil-nāṣiyati"]],[["نَاصِيَةٍ","A forelock","nāṣiyatin"],["كَـٰذِبَةٍ","lying","kādhibatin"],["خَاطِئَةٍ","sinful","khāṭi-atin"]],[["فَلْيَدْعُ","Then let him call","falyadʿu"],["نَادِيَهُۥ","his associates","nādiyahu"]],[["سَنَدْعُ","We will call","sanadʿu"],["ٱلزَّبَانِيَةَ","the Angels of Hell","l-zabāniyata"]],[["كَلَّا","Nay","kallā"],["لَا","(Do) not","lā"],["تُطِعْهُ","obey him","tuṭiʿ'hu"],["وَٱسْجُدْ","But prostrate","wa-us'jud"],["وَٱقْتَرِب ۩","and draw near (to Allah)","wa-iq'tarib"]]]}