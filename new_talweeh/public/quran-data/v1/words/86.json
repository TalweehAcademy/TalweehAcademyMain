) Able","laqādirun","لَقَادِرٌ"]],[["يَوْمَ","(The) Day","yawma","یَوْمَ"],["تُبْلَى","will be tested","tub'lā","تُبْلَی"],["ٱلسَّرَآئِرُ","the secrets","l-sarāiru","السَّرَآىِٕرُ"]],[["فَمَا","Then not","famā","فَمَا"],["لَهُۥ","(is) for him","lahu","لَهٗ"],["مِن","any","min","مِنْ"],["قُوَّةٍ","power","quwwatin","قُوَّةٍ"],["وَلَا","and not","walā","وَّلَا"],["نَاصِرٍ","any helper","nāṣirin","نَاصِرٍ"]],[["وَٱلسَّمَآءِ","By the sky","wal-samāi","وَالسَّمَآءِ"],["ذَاتِ","which","dhāti","ذَاتِ"],["ٱلرَّجْعِ","returns","l-rajʿi","الرَّجْعِ"]],[["وَٱلْأَرْضِ","And the earth","wal-arḍi","وَالْاَرْضِ"],["ذَاتِ","which","dhāti","ذَاتِ"],["ٱلصَّدْعِ","cracks open","l-ṣadʿi","الصَّدْعِ"]],[["إِنَّهُۥ","Indeed, it","innahu","اِنَّهٗ"],["لَقَوْلٌ","(is) surely a Word","laqawlun","لَقَوْلٌ"],["فَصْلٌ","decisive","faṣlun","فَصْلٌ"]],[["وَمَا","And not","wamā","وَّمَا"],["هُوَ","it","huwa","هُوَ"],["بِٱلْهَزْلِ","(is) for amusement","bil-hazli","بِالْهَزْلِ"]],[["إِنَّهُمْ","Indeed, they","innahum","اِنَّهُمْ"],["يَكِيدُونَ","are plotting","yakīdūna","یَكِیْدُوْنَ"],["كَيْدًا","a plot","kaydan","كَیْدًا"]],[["وَأَكِيدُ","But I am planning","wa-akīdu","وَّاَكِیْدُ"],["كَيْدًا","a plan","kaydan","كَیْدًا"]],[["فَمَهِّلِ","So give respite","famahhili","فَمَهِّلِ"],["ٱلْكَـٰفِرِينَ","(to) the disbelievers","l-kāfirīna","الْكٰفِرِیْنَ"],["أَمْهِلْهُمْ","Give respite to them ","amhil'hum","اَمْهِلْهُمْ"],["رُوَيْدًۢا","little","ruwaydan","رُوَیْدًا"]]]}