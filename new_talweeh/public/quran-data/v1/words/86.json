َآءِ","By the sky","wal-samāi"],["ذَاتِ","which","dhāti"],["ٱلرَّجْعِ","returns","l-rajʿi"]],[["وَٱلْأَرْضِ","And the earth","wal-arḍi"],["ذَاتِ","which","dhāti"],["ٱلصَّدْعِ","cracks open","l-ṣadʿi"]],[["إِنَّهُۥ","Indeed, it","innahu"],["لَقَوْلٌ","(is) surely a Word","laqawlun"],["فَصْلٌ","decisive","faṣlun"]],[["وَمَا","And not","wamā"],["هُوَ","it","huwa"],["بِٱلْهَزْلِ","(is) for amusement","bil-hazli"]],[["إِنَّهُمْ","Indeed, they","innahum"],["يَكِيدُونَ","are plotting","yakīdūna"],["كَيْدًا","a plot","kaydan"]],[["وَأَكِيدُ","But I am planning","wa-akīdu"],["كَيْدًا","a plan","kaydan"]],[["فَمَهِّلِ","So give respite","famahhili"],["ٱلْكَـٰفِرِينَ","(to) the disbelievers","l-kāfirīna"],["أَمْهِلْهُمْ","Give respite to them ","amhil'hum"],["رُوَيْدًۢا","little","ruwaydan"]]]}