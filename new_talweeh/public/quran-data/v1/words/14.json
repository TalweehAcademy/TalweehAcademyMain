adīdin","شَدِیْدِ"]],[["ٱلَّذِينَ","Those who","alladhīna","لَّذِیْنَ"],["يَسْتَحِبُّونَ","love more","yastaḥibbūna","یَسْتَحِبُّوْنَ"],["ٱلْحَيَوٰةَ","the life","l-ḥayata","الْحَیٰوةَ"],["ٱلدُّنْيَا","(of) the world","l-dun'yā","الدُّنْیَا"],["عَلَى","than","ʿalā","عَلَی"],["ٱلْـَٔاخِرَةِ","the Hereafter","l-ākhirati","الْاٰخِرَةِ"],["وَيَصُدُّونَ","and hinder","wayaṣuddūna","وَیَصُدُّوْنَ"],["عَن","from","ʿan","عَنْ"],["سَبِيلِ","(the) Path","sabīli","سَبِیْلِ"],["ٱللَّهِ","(of) Allah","l-lahi","اللّٰهِ"],["وَيَبْغُونَهَا","and seek in it","wayabghūnahā","وَیَبْغُوْنَهَا"],["عِوَجًا ۚ","crookedness","ʿiwajan","عِوَجًا ؕ"],["أُو۟لَـٰٓئِكَ","those","ulāika","اُولٰٓىِٕكَ"],["فِى","[in]","fī","فِیْ"],["ضَلَـٰلٍۭ","(are) far astray","ḍalālin","ضَلٰلٍ"],["بَعِيدٍ","(are) far astray","baʿīdin","بَعِیْدٍ"]],[["وَمَآ","And not","wamā","وَمَاۤ"],["أَرْسَلْنَا","We sent","arsalnā","اَرْسَلْنَا"],["مِن","any","min","مِنْ"],["رَّسُولٍ","Messenger","rasūlin","رَّسُوْلٍ"],["إِلَّا","except","illā","اِلَّا"],["بِلِسَانِ","with the language","bilisāni","بِلِسَانِ"],["قَوْمِهِۦ","(of) his people","qawmihi","قَوْمِهٖ"],["لِيُبَيِّنَ","so that he might make clear","liyubayyina","لِیُبَیِّنَ"],["لَهُمْ ۖ","for them","lahum","لَهُمْ ؕ"],["فَيُضِلُّ","Then Allah lets go astray","fayuḍillu","فَیُضِلُّ"],["ٱللَّهُ","Then Allah lets go astray","l-lahu","اللّٰهُ"],["مَن","whom","man","مَنْ"],["يَشَآءُ","He wills","yashāu","یَّشَآءُ"],["وَيَهْدِى","and guides","wayahdī","وَیَهْدِیْ"],["مَن","whom","man","مَنْ"],["يَشَآءُ ۚ","He wills","yashāu","یَّشَآءُ ؕ"],["وَهُوَ","And He","wahuwa","وَهُوَ"],["ٱلْعَزِيزُ","(is) the All-Mighty","l-ʿazīzu","الْعَزِیْزُ"],["ٱلْحَكِيمُ","the All-Wise","l-ḥakīmu","الْحَكِیْمُ"]],[["وَلَقَدْ","And verily","walaqad","وَلَقَدْ"],["أَرْسَلْنَا","We sent","arsalnā","اَرْسَلْنَا"],["مُوسَىٰ","Musa","mūsā","مُوْسٰی"],["بِـَٔايَـٰتِنَآ","with Our Signs","biāyātinā","بِاٰیٰتِنَاۤ"],["أَنْ","that","an","اَنْ"],["أَخْرِجْ","Bring out","akhrij","اَخْرِجْ"],["قَوْمَك