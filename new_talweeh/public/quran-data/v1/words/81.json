 ablaze","suʿʿirat"]],[["وَإِذَا","And when","wa-idhā"],["ٱلْجَنَّةُ","Paradise","l-janatu"],["أُزْلِفَتْ","is brought near","uz'lifat"]],[["عَلِمَتْ","Will know","ʿalimat"],["نَفْسٌ","a soul","nafsun"],["مَّآ","what","mā"],["أَحْضَرَتْ","it has brought","aḥḍarat"]],[["فَلَآ","But nay","falā"],["أُقْسِمُ","I swear","uq'simu"],["بِٱلْخُنَّسِ","by the retreating planets","bil-khunasi"]],[["ٱلْجَوَارِ","Those that run","al-jawāri"],["ٱلْكُنَّسِ","(and) disappear","l-kunasi"]],[["وَٱلَّيْلِ","And the night","wa-al-layli"],["إِذَا","when","idhā"],["عَسْعَسَ","it departs","ʿasʿasa"]],[["وَٱلصُّبْحِ","And the dawn","wal-ṣub'ḥi"],["إِذَا","when","idhā"],["تَنَفَّسَ","it breathes","tanaffasa"]],[["إِنَّهُۥ","Indeed, it","innahu"],["لَقَوْلُ","(is) surely a word","laqawlu"],["رَسُولٍ","(of) a Messenger","rasūlin"],["كَرِيمٍ","noble","karīmin"]],[["ذِى","Possessor of","dhī"],["قُوَّةٍ","power","quwwatin"],["عِندَ","with","ʿinda"],["ذِى","(the) Owner of","dhī"],["ٱلْعَرْشِ","the Throne","l-ʿarshi"],["مَكِينٍ","secure","makīnin"]],[["مُّطَاعٍ","One to be obeyed","muṭāʿin"],["ثَمَّ","and","thamma"],["أَمِينٍ","trustworthy","amīnin"]],[["وَمَا","And not","wamā"],["صَاحِبُكُم","(is) your companion","ṣāḥibukum"],["بِمَجْنُونٍ","mad","bimajnūnin"]],[["وَلَقَدْ","And certainly","walaqad"],["رَءَاهُ","he saw him","raāhu"],["بِٱلْأُفُقِ","in the horizon","bil-ufuqi"],["ٱلْمُبِينِ","the clear","l-mubīni"]],[["وَمَا","And not","wamā"],["هُوَ","he (is)","huwa"],["عَلَى","on","ʿalā"],["ٱلْغَيْبِ","the unseen","l-ghaybi"],["بِضَنِينٍ","a withholder","biḍanīnin"]],[["وَمَا","And not","wamā"],["هُوَ","it","huwa"],["بِقَوْلِ","(is the) word","biqawli"],["شَيْطَـٰنٍ","(of) Shaitaan","shayṭānin"],["رَّجِيمٍ","accursed","rajīmin"]],[["فَأَيْنَ","So where","fa-ayna"],["تَذْهَبُونَ","are you going","tadhhabūna"]],[["إِنْ","Not","in"],["هُوَ","it","huwa"],["إِلَّا","(is) except","illā"],["ذِكْرٌ","a reminder","dhik'run"],["لِّلْعَـٰلَمِينَ","to the worlds","lil'ʿālamīna"]],[["لِمَن","For whoever","liman"],["شَآءَ","wills","shāa"],["مِنكُمْ","among you","minkum"],["أَن","to","an"],["يَسْتَقِيمَ","take a straight way","yastaqīma"]],[["وَمَا","And not","wamā"],["تَشَآءُونَ","you will","tashāūna"],["إِلَّآ","except","illā"],["أَن","that","an"],["يَشَآءَ","wills","yashāa"],["ٱللَّهُ","Allah","l-lahu"],["رَبُّ","Lord","rabbu"],["ٱلْعَـٰلَمِينَ","(of) the worlds","l-ʿālamīna"]]]}