"تُدْهِنُ","you should compromise","tud'hinu"],["فَيُدْهِنُونَ","so they would compromise","fayud'hinūna"]],[["وَلَا","And (do) not","walā"],["تُطِعْ","obey","tuṭiʿ"],["كُلَّ","every","kulla"],["حَلَّافٍ","habitual swearer","ḥallāfin"],["مَّهِينٍ","worthless","mahīnin"]],[["هَمَّازٍ","Defamer","hammāzin"],["مَّشَّآءٍۭ","going about","mashāin"],["بِنَمِيمٍ","with malicious gossip","binamīmin"]],[["مَّنَّاعٍ","A preventer","mannāʿin"],["لِّلْخَيْرِ","of (the) good","lil'khayri"],["مُعْتَدٍ","transgressor","muʿ'tadin"],["أَثِيمٍ","sinful","athīmin"]],[["عُتُلٍّۭ","Cruel","ʿutullin"],["بَعْدَ","after","baʿda"],["ذَٰلِكَ","(all) that","dhālika"],["زَنِيمٍ","utterly useless","zanīmin"]],[["أَن","Because","an"],["كَانَ","(he) is","kāna"],["ذَا","a possessor","dhā"],["مَالٍ","(of) wealth","mālin"],["وَبَنِينَ","and children","wabanīna"]],[["إِذَا","When","idhā"],["تُتْلَىٰ","are recited","tut'lā"],["عَلَيْهِ","to him","ʿalayhi"],["ءَايَـٰتُنَا","Our Verses","āyātunā"],["قَالَ","he says","qāla"],["أَسَـٰطِيرُ","Stories","asāṭīru"],["ٱلْأَوَّلِينَ","(of) the former (people)","l-awalīna"]],[["سَنَسِمُهُۥ","We will brand him","sanasimuhu"],["عَلَى","on","ʿalā"],["ٱلْخُرْطُومِ","the snout","l-khur'ṭūmi"]],[["إِنَّا","Indeed, We","innā"],["بَلَوْنَـٰهُمْ","have tried them","balawnāhum"],["كَمَا","as","kamā"],["بَلَوْنَآ","We tried","balawnā"],["أَصْحَـٰبَ","(the) companions","aṣḥāba"],["ٱلْجَنَّةِ","(of) the garden","l-janati"],["إِذْ","when","idh"],["أَقْسَمُوا۟","they swore","aqsamū"],["لَيَصْرِمُنَّهَا","to pluck its fruit","layaṣrimunnahā"],["مُصْبِحِينَ","(in the) morning","muṣ'biḥīna"]],[["وَلَا","And not","walā"],["يَسْتَثْنُونَ","making exception","yastathnūna"]],[["فَطَافَ","So there came","faṭāfa"],["عَلَيْهَا","upon it","ʿalayhā"],["طَآئِفٌ","a visitation","ṭāifun"],["مِّن","from","min"],["رَّبِّكَ","your Lord","rabbika"],["وَهُمْ","while they","wahum"],["نَآئِمُونَ","were asleep","nāimūna"]],[["فَأَصْبَحَتْ","So it became","fa-aṣbaḥat"],["كَٱلصَّرِيمِ","as if reaped","kal-ṣarīmi"]],[["فَتَنَادَوْا۟","And they called one another","fatanādaw"],["مُصْبِحِينَ","(at) morning","muṣ'biḥīna"]],[["أَنِ","That","ani"],["ٱغْدُوا۟","Go early","igh'dū"],["عَلَىٰ","to","ʿalā"],["حَرْثِكُمْ","your crop","ḥarthikum"],["إِن","if","in"],["كُنتُمْ","you would","kuntum"],["صَـٰرِمِينَ","pluck (the) fruit","ṣārimīna"]],[["فَٱنطَلَقُوا۟","So they went","fa-inṭalaqū"],["وَهُمْ","while they","wahum"],["يَتَخَـٰفَتُونَ","lowered (their) voices","yatakhāfatūna"]],[["أَن","That","an"],["لَّا","Not","lā"],["يَدْخُلَنَّهَا","will enter it","yadkhulannahā"],["ٱلْيَوْمَ","today","l-yawma"],["عَلَيْكُم","upon you","ʿalaykum"],["مِّسْكِينٌ","any poor person","mis'kīnun"]],[["وَغَدَوْا۟","And they went early","waghadaw"],["عَلَىٰ","with","ʿalā"],["حَرْدٍ","determination","ḥardin"],["قَـٰدِرِينَ","able","qādirīna"]],[["فَلَمَّا","But when","falammā"],["رَأَوْهَا","they saw it","ra-awhā"],["قَالُوٓا۟","they said","qālū"],["إِنَّا","Indeed, we","innā"],["لَضَآلُّونَ","(are) surely lost","laḍāllūna"]],[["بَلْ","Nay","bal"],["نَحْنُ","We","naḥnu"],["مَحْرُومُونَ","(are) deprived","maḥrūmūna"]],[["قَالَ","Said","qāla"],["أَوْسَطُهُمْ","(the) most moderate of them","awsaṭuhum"],["أَلَمْ","Did not","alam"],["أَقُل","I tell","aqul"],["لَّكُمْ","you","lakum"],["لَوْلَا","'Why not","lawlā"],["تُسَبِّحُونَ","you glorify (Allah)?'","tusabbiḥūna"]],[["قَالُوا۟","They said","qālū"],["سُبْحَـٰنَ","Glory be","sub'ḥāna"],["رَبِّنَآ","(to) our Lord","rabbinā"],["إِنَّا","Indeed, we","innā"],["كُنَّا","[we] were","kunnā"],["ظَـٰلِمِينَ","wrongdoers","ẓālimīna"]],[["فَأَقْبَلَ","Then approached","fa-aqbala"],["بَعْضُهُمْ","some of them","baʿḍuhum"],["عَلَىٰ","to","ʿalā"],["بَعْضٍ","others","baʿḍin"],["يَتَلَـٰوَمُونَ","blaming each other","yatalāwamūna"]],[["قَالُوا۟","They said","qālū"],["يَـٰوَيْلَنَآ","O woe to us","yāwaylanā"],["إِنَّا","Indeed, we","innā"],["كُنَّا","[we] were","kunnā"],["طَـٰغِينَ","transgressors","ṭāghīna"]],[["عَسَىٰ","Perhaps","ʿasā"],["رَبُّنَآ","our Lord","rabbunā"],["أَن","[that]","an"],["يُبْدِلَنَا","will substitute for us","yub'dilanā"],["خَيْرًا","a better","khayran"],["مِّنْهَآ","than it","min'hā"],["إِنَّآ","Indeed, we","innā"],["إِلَىٰ","to","ilā"],["رَبِّنَا","our Lord","rabbinā"],["رَٰغِبُونَ","turn devoutly","rāghibūna"]],[["كَذَٰلِكَ","Such","kadhālika"],["ٱلْعَذَابُ ۖ","(is) the punishment","l-ʿadhābu"],["وَلَعَذَابُ","And surely the punishment","walaʿadhābu"],["ٱلْـَٔاخِرَةِ","(of) the Hereafter","l-ākhirati"],["أَكْبَرُ ۚ","(is) greater","akbaru"],["لَوْ","if","law"],["كَانُوا۟","they","kānū"],["يَعْلَمُونَ","know","yaʿlamūna"]],[["إِنَّ","Indeed","inna"],["لِلْمُتَّقِينَ","for the righteous","lil'muttaqīna"],["عِندَ","with","ʿinda"],["رَبِّهِمْ","their Lord","rabbihim"],["جَنَّـٰتِ","(are) Gardens","jannāti"],["ٱلنَّعِيمِ","(of) Delight","l-naʿīmi"]],[["أَفَنَجْعَلُ","Then will We treat","afanajʿalu"],["ٱلْمُسْلِمِينَ","the Muslims","l-mus'limīna"],["كَٱلْمُجْرِمِينَ","like the criminals","kal-muj'rimīna"]],[["مَا","What","mā"],["لَكُمْ","(is) for you","lakum"],["كَيْفَ","How","kayfa"],["تَحْكُمُونَ","(do) you judge","taḥkumūna"]],[["أَمْ","Or","am"],["لَكُمْ","(is) for you","lakum"],["كِتَـٰبٌ","a book","kitābun"],["فِيهِ","wherein","fīhi"],["تَدْرُسُونَ","you learn","tadrusūna"]],[["إِنَّ","Indeed","inna"],["لَكُمْ","for you","lakum"],["فِيهِ","in it","fīhi"],["لَمَا","what","lamā"],["تَخَيَّرُونَ","you choose","takhayyarūna"]],[["أَمْ","Or","am"],["لَكُمْ","for you","lakum"],["أَيْمَـٰنٌ","oaths","aymānun"],["عَلَيْنَا","from us","ʿalaynā"],["بَـٰلِغَةٌ","reaching","bālighatun"],["إِلَىٰ","to","ilā"],["يَوْمِ","(the) Day","yawmi"],["ٱلْقِيَـٰمَةِ ۙ","(of) the Resurrection","l-qiyāmati"],["إِنَّ","indeed","inna"],["لَكُمْ","for you","lakum"],["لَمَا","(is) what","lamā"],["تَحْكُمُونَ","you judge","taḥkumūna"]],[["سَلْهُمْ","Ask them","salhum"],["أَيُّهُم","which of them","ayyuhum"],["بِذَٰلِكَ","for that","bidhālika"],["زَعِيمٌ","(is) responsible","zaʿīmun"]],[["أَمْ","Or","am"],["لَهُمْ","(are) for them","lahum"],["شُرَكَآءُ","partners","shurakāu"],["فَلْيَأْتُوا۟","Then let them bring","falyatū"],["بِشُرَكَآئِهِمْ","their partners","bishurakāihim"],["إِن","if","in"],["كَانُوا۟","they are","kānū"],["صَـٰدِقِينَ","truthful","ṣādiqīna"]],[["يَوْمَ","(The) Day","yawma"],["يُكْشَفُ","will be uncovered","yuk'shafu"],["عَن","from","ʿan"],["سَاقٍ","the shin","sāqin"],["وَيُدْعَوْنَ","and they will be called","wayud'ʿawna"],["إِلَى","to","ilā"],["ٱلسُّجُودِ","prostrate","l-sujūdi"],["فَلَا","but not","falā"],["يَسْتَطِيعُونَ","they will be able","yastaṭīʿūna"]],[["خَـٰشِعَةً","Humbled","khāshiʿatan"],["أَبْصَـٰرُهُمْ","their eyes","abṣāruhum"],["تَرْهَقُهُمْ","will cover them","tarhaquhum"],["ذِلَّةٌ ۖ","humiliation","dhillatun"],["وَقَدْ","And indeed","waqad"],["كَانُوا۟","they were","kānū"],["يُدْعَوْنَ","called","yud'ʿawna"],["إِلَى","to","ilā"],["ٱلسُّجُودِ","prostrate","l-sujūdi"],["وَهُمْ","while they","wahum"],["سَـٰلِمُونَ","(were) sound","sālimūna"]],[["فَذَرْنِى","So leave Me","fadharnī"],["وَمَن","and whoever","waman"],["يُكَذِّبُ","denies","yukadhibu"],["بِهَـٰذَا","this","bihādhā"],["ٱلْحَدِيثِ ۖ","Statement","l-ḥadīthi"],["سَنَسْتَدْرِجُهُم","We will progressively lead them","sanastadrijuhum"],["مِّنْ","from","min"],["حَيْثُ","where","ḥaythu"],["لَا","not","lā"],["يَعْلَمُونَ","they know","yaʿlamūna"]],[["وَأُمْلِى","And I will give respite","wa-um'lī"],["لَهُمْ ۚ","to them","lahum"],["إِنَّ","Indeed","inna"],["كَيْدِى","My plan","kaydī"],["مَتِينٌ","(is) firm","matīnun"]],[["أَمْ","Or","am"],["تَسْـَٔلُهُمْ","you ask them","tasaluhum"],["أَجْرًا","a payment","ajran"],["فَهُم","so they","fahum"],["مِّن","from","min"],["مَّغْرَمٍ","(the) debt","maghramin"],["مُّثْقَلُونَ","(are) burdened","muth'qalūna"]],[["أَمْ","Or","am"],["عِندَهُمُ","(is) with them","ʿindahumu"],["ٱلْغَيْبُ","the unseen","l-ghaybu"],["فَهُمْ","so they","fahum"],["يَكْتُبُونَ","write it","yaktubūna"]],[["فَٱصْبِرْ","So be patient","fa-iṣ'bir"],["لِحُكْمِ","for (the) decision","liḥuk'mi"],["رَبِّكَ","(of) your Lord","rabbika"],["وَلَا","and (do) not","walā"],["تَكُن","be","takun"],["كَصَاحِبِ","like (the) companion","kaṣāḥibi"],["ٱلْحُوتِ","(of) the fish","l-ḥūti"],["إِذْ","when","idh"],["نَادَىٰ","he called out","nādā"],["وَهُوَ","while he","wahuwa"],["مَكْظُومٌ","(was) distressed","makẓūmun"]],[["لَّوْلَآ","If not","lawlā"],["أَن","that","an"],["تَدَٰرَكَهُۥ","overtook him","tadārakahu"],["نِعْمَةٌ","a Favor","niʿ'matun"],["مِّن","from","min"],["رَّبِّهِۦ","his Lord","rabbihi"],["لَنُبِذَ","surely he would have been thrown","lanubidha"],["بِٱلْعَرَآءِ","onto (the) naked shore","bil-ʿarāi"],["وَهُوَ","while he","wahuwa"],["مَذْمُومٌ","(was) blamed","madhmūmun"]],[["فَٱجْتَبَـٰهُ","But chose him","fa-ij'tabāhu"],["رَبُّهُۥ","his Lord","rabbuhu"],["فَجَعَلَهُۥ","and made him","fajaʿalahu"],["مِنَ","of","mina"],["ٱلصَّـٰلِحِينَ","the righteous","l-ṣāliḥīna"]],[["وَإِن","And indeed","wa-in"],["يَكَادُ","would almost","yakādu"],["ٱلَّذِينَ","those who","alladhīna"],["كَفَرُوا۟","disbelieve","kafarū"],["لَيُزْلِقُونَكَ","surely make you slip","layuz'liqūnaka"],["بِأَبْصَـٰرِهِمْ","with their look","bi-abṣārihim"],["لَمَّا","when","lammā"],["سَمِعُوا۟","they hear","samiʿū"],["ٱلذِّكْرَ","the Message","l-dhik'ra"],["وَيَقُولُونَ","and they say","wayaqūlūna"],["إِنَّهُۥ","Indeed, he","innahu"],["لَمَجْنُونٌ","(is) surely mad","lamajnūnun"]],[["وَمَا","And not","wamā"],["هُوَ","it (is)","huwa"],["إِلَّا","but","illā"],["ذِكْرٌ","a Reminder","dhik'run"],["لِّلْعَـٰلَمِينَ","to the worlds","lil'ʿālamīna"]]]}