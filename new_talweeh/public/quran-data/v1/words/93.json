["فَأَمَّا","So as for","fa-ammā","فَاَمَّا"],["ٱلْيَتِيمَ","the orphan","l-yatīma","الْیَتِیْمَ"],["فَلَا","then (do) not","falā","فَلَا"],["تَقْهَرْ","oppress","taqhar","تَقْهَرْ"]],[["وَأَمَّا","And as for","wa-ammā","وَاَمَّا"],["ٱلسَّآئِلَ","one who asks","l-sāila","السَّآىِٕلَ"],["فَلَا","then (do) not","falā","فَلَا"],["تَنْهَرْ","repel","tanhar","تَنْهَرْ"]],[["وَأَمَّا","But as for","wa-ammā","وَاَمَّا"],["بِنِعْمَةِ","(the) Favor","biniʿ'mati","بِنِعْمَةِ"],["رَبِّكَ","(of) your Lord","rabbika","رَبِّكَ"],["فَحَدِّثْ","narrate","faḥaddith","فَحَدِّثْ"]]]}