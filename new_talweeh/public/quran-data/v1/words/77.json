n"]],[["وَيْلٌ","Woe","waylun"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["لِّلْمُكَذِّبِينَ","to the deniers","lil'mukadhibīna"]],[["ٱنطَلِقُوٓا۟","Proceed","inṭaliqū"],["إِلَىٰ","to","ilā"],["مَا","what","mā"],["كُنتُم","you used to","kuntum"],["بِهِۦ","in it","bihi"],["تُكَذِّبُونَ","deny","tukadhibūna"]],[["ٱنطَلِقُوٓا۟","Proceed","inṭaliqū"],["إِلَىٰ","to","ilā"],["ظِلٍّ","a shadow","ẓillin"],["ذِى","having","dhī"],["ثَلَـٰثِ","three","thalāthi"],["شُعَبٍ","columns","shuʿabin"]],[["لَّا","No","lā"],["ظَلِيلٍ","cool shade","ẓalīlin"],["وَلَا","and not","walā"],["يُغْنِى","availing","yugh'nī"],["مِنَ","against","mina"],["ٱللَّهَبِ","the flame","l-lahabi"]],[["إِنَّهَا","Indeed, it","innahā"],["تَرْمِى","throws up","tarmī"],["بِشَرَرٍ","sparks","bishararin"],["كَٱلْقَصْرِ","as the fortress","kal-qaṣri"]],[["كَأَنَّهُۥ","As if they (were)","ka-annahu"],["جِمَـٰلَتٌ","camels","jimālatun"],["صُفْرٌ","yellow","ṣuf'run"]],[["وَيْلٌ","Woe","waylun"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["لِّلْمُكَذِّبِينَ","to the deniers","lil'mukadhibīna"]],[["هَـٰذَا","This","hādhā"],["يَوْمُ","(is) a Day","yawmu"],["لَا","not","lā"],["يَنطِقُونَ","they will speak","yanṭiqūna"]],[["وَلَا","And not","walā"],["يُؤْذَنُ","will it be permitted","yu'dhanu"],["لَهُمْ","for them","lahum"],["فَيَعْتَذِرُونَ","to make excuses","fayaʿtadhirūna"]],[["وَيْلٌ","Woe","waylun"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["لِّلْمُكَذِّبِينَ","to the deniers","lil'mukadhibīna"]],[["هَـٰذَا","This","hādhā"],["يَوْمُ","(is the) Day","yawmu"],["ٱلْفَصْلِ ۖ","(of) Judgment","l-faṣli"],["جَمَعْنَـٰكُمْ","We have gathered you","jamaʿnākum"],["وَٱلْأَوَّلِينَ","and the former (people)","wal-awalīna"]],[["فَإِن","So if","fa-in"],["كَانَ","is","kāna"],["لَكُمْ","for you","lakum"],["كَيْدٌ","a plan","kaydun"],["فَكِيدُونِ","then plan against Me","fakīdūni"]],[["وَيْلٌ","Woe","waylun"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["لِّلْمُكَذِّبِينَ","to the deniers","lil'mukadhibīna"]],[["إِنَّ","Indeed","inna"],["ٱلْمُتَّقِينَ","the righteous","l-mutaqīna"],["فِى","(will be) in","fī"],["ظِلَـٰلٍ","shades","ẓilālin"],["وَعُيُونٍ","and springs","waʿuyūnin"]],[["وَفَوَٰكِهَ","And fruits","wafawākiha"],["مِمَّا","from what","mimmā"],["يَشْتَهُونَ","they desire","yashtahūna"]],[["كُلُوا۟","Eat","kulū"],["وَٱشْرَبُوا۟","and drink","wa-ish'rabū"],["هَنِيٓـًٔۢا","(in) satisfaction","hanīan"],["بِمَا","for what","bimā"],["كُنتُمْ","you used to","kuntum"],["تَعْمَلُونَ","do","taʿmalūna"]],[["إِنَّا","Indeed, We","innā"],["كَذَٰلِكَ","thus","kadhālika"],["نَجْزِى","reward","najzī"],["ٱلْمُحْسِنِينَ","the good-doers","l-muḥ'sinīna"]],[["وَيْلٌ","Woe","waylun"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["لِّلْمُكَذِّبِينَ","to the deniers","lil'mukadhibīna"]],[["كُلُوا۟","Eat","kulū"],["وَتَمَتَّعُوا۟","and enjoy yourselves","watamattaʿū"],["قَلِيلًا","a little","qalīlan"],["إِنَّكُم","indeed, you","innakum"],["مُّجْرِمُونَ","(are) criminals","muj'rimūna"]],[["وَيْلٌ","Woe","waylun"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["لِّلْمُكَذِّبِينَ","to the deniers","lil'mukadhibīna"]],[["وَإِذَا","And when","wa-idhā"],["قِيلَ","it is said","qīla"],["لَهُمُ","to them","lahumu"],["ٱرْكَعُوا۟","Bow","ir'kaʿū"],["لَا","not","lā"],["يَرْكَعُونَ","they bow","yarkaʿūna"]],[["وَيْلٌ","Woe","waylun"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["لِّلْمُكَذِّبِينَ","to the deniers","lil'mukadhibīna"]],[["فَبِأَىِّ","Then in what","fabi-ayyi"],["حَدِيثٍۭ","statement","ḥadīthin"],["بَعْدَهُۥ","after it","baʿdahu"],["يُؤْمِنُونَ","will they believe","yu'minūna"]]]}