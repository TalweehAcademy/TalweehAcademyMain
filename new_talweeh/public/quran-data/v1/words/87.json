d will avoid it","wayatajannabuhā"],["ٱلْأَشْقَى","the wretched one","l-ashqā"]],[["ٱلَّذِى","The one who","alladhī"],["يَصْلَى","will burn","yaṣlā"],["ٱلنَّارَ","(in) the Fire","l-nāra"],["ٱلْكُبْرَىٰ","[the] great","l-kub'rā"]],[["ثُمَّ","Then","thumma"],["لَا","not","lā"],["يَمُوتُ","he will die","yamūtu"],["فِيهَا","therein","fīhā"],["وَلَا","and not","walā"],["يَحْيَىٰ","will live","yaḥyā"]],[["قَدْ","Certainly","qad"],["أَفْلَحَ","has succeeded","aflaḥa"],["مَن","(one) who","man"],["تَزَكَّىٰ","purifies (himself)","tazakkā"]],[["وَذَكَرَ","And remembers","wadhakara"],["ٱسْمَ","(the) name","is'ma"],["رَبِّهِۦ","(of) his Lord","rabbihi"],["فَصَلَّىٰ","and prays","faṣallā"]],[["بَلْ","Nay","bal"],["تُؤْثِرُونَ","You prefer","tu'thirūna"],["ٱلْحَيَوٰةَ","the life","l-ḥayata"],["ٱلدُّنْيَا","(of) the world","l-dun'yā"]],[["وَٱلْـَٔاخِرَةُ","While the Hereafter","wal-ākhiratu"],["خَيْرٌ","(is) better","khayrun"],["وَأَبْقَىٰٓ","and everlasting","wa-abqā"]],[["إِنَّ","Indeed","inna"],["هَـٰذَا","this","hādhā"],["لَفِى","surely (is) in","lafī"],["ٱلصُّحُفِ","the Scriptures","l-ṣuḥufi"],["ٱلْأُولَىٰ","[the] former","l-ūlā"]],[["صُحُفِ","(The) Scriptures","ṣuḥufi"],["إِبْرَٰهِيمَ","(of) Ibrahim","ib'rāhīma"],["وَمُوسَىٰ","and Musa","wamūsā"]]]}