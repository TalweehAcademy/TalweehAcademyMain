","اَیَّامٍ ۙ"],["حُسُومًا","(in) succession","ḥusūman","حُسُوْمًاۙ"],["فَتَرَى","so you would see","fatarā","فَتَرَی"],["ٱلْقَوْمَ","the people","l-qawma","الْقَوْمَ"],["فِيهَا","therein","fīhā","فِیْهَا"],["صَرْعَىٰ","fallen","ṣarʿā","صَرْعٰی ۙ"],["كَأَنَّهُمْ","as if they were","ka-annahum","كَاَنَّهُمْ"],["أَعْجَازُ","trunks","aʿjāzu","اَعْجَازُ"],["نَخْلٍ","(of) date-palms","nakhlin","نَخْلٍ"],["خَاوِيَةٍ","hollow","khāwiyatin","خَاوِیَةٍ"]],[["فَهَلْ","Then do","fahal","فَهَلْ"],["تَرَىٰ","you see","tarā","تَرٰی"],["لَهُم","of them","lahum","لَهُمْ"],["مِّنۢ","any","min","مِّنْ"],["بَاقِيَةٍ","remains","bāqiyatin","بَاقِیَةٍ"]],[["وَجَآءَ","And came","wajāa","وَجَآءَ"],["فِرْعَوْنُ","Firaun","fir'ʿawnu","فِرْعَوْنُ"],["وَمَن","and (those)","waman","وَمَنْ"],["قَبْلَهُۥ","before him","qablahu","قَبْلَهٗ"],["وَٱلْمُؤْتَفِكَـٰتُ","and the overturned cities","wal-mu'tafikātu","وَالْمُؤْتَفِكٰتُ"],["بِٱلْخَاطِئَةِ","with sin","bil-khāṭi-ati","بِالْخَاطِئَةِ"]],[["فَعَصَوْا۟","And they disobeyed","faʿaṣaw","فَعَصَوْا"],["رَسُولَ","(the) Messenger","rasūla","رَسُوْلَ"],["رَبِّهِمْ","(of) their Lord","rabbihim","رَبِّهِمْ"],["فَأَخَذَهُمْ","so He seized them","fa-akhadhahum","فَاَخَذَهُمْ"],["أَخْذَةً","(with) a seizure","akhdhatan","اَخْذَةً"],["رَّابِيَةً","exceeding","rābiyatan","رَّابِیَةً"]],[["إِنَّا","Indeed, We","innā","اِنَّا"],["لَمَّا","when","lammā","لَمَّا"],["طَغَا","overflowed","ṭaghā","طَغَا"],["ٱلْمَآءُ","the water","l-māu","الْمَآءُ"],["حَمَلْنَـٰكُمْ","We carried you","ḥamalnākum","حَمَلْنٰكُمْ"],["فِى","in","fī","فِی"],["ٱلْجَارِيَةِ","the sailing (ship)","l-jāriyati","الْجَارِیَةِ"]],[["لِنَجْعَلَهَا","That We might make it","linajʿalahā","لِنَجْعَلَهَا"],["لَكُمْ","for you","lakum","لَكُمْ"],["تَذْكِرَةً","a reminder","tadhkiratan","تَذْكِرَةً"],["وَتَعِيَهَآ","and would be conscious of it","wataʿiyahā","وَّتَعِیَهَاۤ"],["أُذُنٌ","an ear","udhunun","اُذُنٌ"],["وَٰعِيَةٌ","conscious","wāʿiyatun","وَّاعِیَةٌ"]],[["فَإِذَا","Then when","fa-idhā