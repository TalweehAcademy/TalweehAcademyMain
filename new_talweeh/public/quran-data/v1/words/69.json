low","khāwiyatin"]],[["فَهَلْ","Then do","fahal"],["تَرَىٰ","you see","tarā"],["لَهُم","of them","lahum"],["مِّنۢ","any","min"],["بَاقِيَةٍ","remains","bāqiyatin"]],[["وَجَآءَ","And came","wajāa"],["فِرْعَوْنُ","Firaun","fir'ʿawnu"],["وَمَن","and (those)","waman"],["قَبْلَهُۥ","before him","qablahu"],["وَٱلْمُؤْتَفِكَـٰتُ","and the overturned cities","wal-mu'tafikātu"],["بِٱلْخَاطِئَةِ","with sin","bil-khāṭi-ati"]],[["فَعَصَوْا۟","And they disobeyed","faʿaṣaw"],["رَسُولَ","(the) Messenger","rasūla"],["رَبِّهِمْ","(of) their Lord","rabbihim"],["فَأَخَذَهُمْ","so He seized them","fa-akhadhahum"],["أَخْذَةً","(with) a seizure","akhdhatan"],["رَّابِيَةً","exceeding","rābiyatan"]],[["إِنَّا","Indeed, We","innā"],["لَمَّا","when","lammā"],["طَغَا","overflowed","ṭaghā"],["ٱلْمَآءُ","the water","l-māu"],["حَمَلْنَـٰكُمْ","We carried you","ḥamalnākum"],["فِى","in","fī"],["ٱلْجَارِيَةِ","the sailing (ship)","l-jāriyati"]],[["لِنَجْعَلَهَا","That We might make it","linajʿalahā"],["لَكُمْ","for you","lakum"],["تَذْكِرَةً","a reminder","tadhkiratan"],["وَتَعِيَهَآ","and would be conscious of it","wataʿiyahā"],["أُذُنٌ","an ear","udhunun"],["وَٰعِيَةٌ","conscious","wāʿiyatun"]],[["فَإِذَا","Then when","fa-idhā"],["نُفِخَ","is blown","nufikha"],["فِى","in","fī"],["ٱلصُّورِ","the trumpet ","l-ṣūri"],["نَفْخَةٌ","a blast","nafkhatun"],["وَٰحِدَةٌ","single","wāḥidatun"]],[["وَحُمِلَتِ","And are lifted","waḥumilati"],["ٱلْأَرْضُ","the earth","l-arḍu"],["وَٱلْجِبَالُ","and the mountains","wal-jibālu"],["فَدُكَّتَا","and crushed","fadukkatā"],["دَكَّةً","(with) a crushing","dakkatan"],["وَٰحِدَةً","single","wāḥidatan"]],[["فَيَوْمَئِذٍ","Then (on) that Day","fayawma-idhin"],["وَقَعَتِ","will occur","waqaʿati"],["ٱلْوَاقِعَةُ","the Occurrence","l-wāqiʿatu"]],[["وَٱنشَقَّتِ","And will split","wa-inshaqqati"],["ٱلسَّمَآءُ","the heaven","l-samāu"],["فَهِىَ","so it","fahiya"],["يَوْمَئِذٍ","(is on) that Day","yawma-idhin"],["وَاهِيَةٌ","frail","wāhiyatun"]],[["وَٱلْمَلَكُ","And the Angels","wal-malaku"],["عَلَىٰٓ","(will be) on","ʿalā"],["أَرْجَآئِهَا ۚ","its edges","arjāihā"],["وَيَحْمِلُ","and will bear","wayaḥmilu"],["عَرْشَ","(the) Throne","ʿarsha"],["رَبِّكَ","(of) your Lord","rabbika"],["فَوْقَهُمْ","above them","fawqahum"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["ثَمَـٰنِيَةٌ","eight","thamāniyatun"]],[["يَوْمَئِذٍ","That Day","yawma-idhin"],["تُعْرَضُونَ","you will be exhibited","tuʿ'raḍūna"],["لَا","not","lā"],["تَخْفَىٰ","will be hidden","takhfā"],["مِنكُمْ","among you","minkum"],["خَافِيَةٌ","any secret","khāfiyatun"]],[["فَأَمَّا","Then as for","fa-ammā"],["مَنْ","(him) who","man"],["أُوتِىَ","is given","ūtiya"],["كِتَـٰبَهُۥ","his record","kitābahu"],["بِيَمِينِهِۦ","in his right hand","biyamīnihi"],["فَيَقُولُ","will say","fayaqūlu"],["هَآؤُمُ","Here","hāumu"],["ٱقْرَءُوا۟","read","iq'raū"],["كِتَـٰبِيَهْ","my record","kitābiyah"]],[["إِنِّى","Indeed, I","innī"],["ظَنَنتُ","was certain","ẓanantu"],["أَنِّى","that I","annī"],["مُلَـٰقٍ","(will) meet","mulāqin"],["حِسَابِيَهْ","my account","ḥisābiyah"]],[["فَهُوَ","So he","fahuwa"],["فِى","(will be) in","fī"],["عِيشَةٍ","a life","ʿīshatin"],["رَّاضِيَةٍ","pleasant","rāḍiyatin"]],[["فِى","In","fī"],["جَنَّةٍ","a Garden","jannatin"],["عَالِيَةٍ","elevated","ʿāliyatin"]],[["قُطُوفُهَا","Its clusters of fruits","quṭūfuhā"],["دَانِيَةٌ","hanging near","dāniyatun"]],[["كُلُوا۟","Eat","kulū"],["وَٱشْرَبُوا۟","and drink","wa-ish'rabū"],["هَنِيٓـًٔۢا","(in) satisfaction","hanīan"],["بِمَآ","for what","bimā"],["أَسْلَفْتُمْ","you sent before you","aslaftum"],["فِى","in","fī"],["ٱلْأَيَّامِ","the days","l-ayāmi"],["ٱلْخَالِيَةِ","past","l-khāliyati"]],[["وَأَمَّا","But as for","wa-ammā"],["مَنْ","(him) who","man"],["أُوتِىَ","is given","ūtiya"],["كِتَـٰبَهُۥ","his record","kitābahu"],["بِشِمَالِهِۦ","in his left hand","bishimālihi"],["فَيَقُولُ","will say","fayaqūlu"],["يَـٰلَيْتَنِى","O! I wish","yālaytanī"],["لَمْ","not","lam"],["أُوتَ","I had been given","ūta"],["كِتَـٰبِيَهْ","my record","kitābiyah"]],[["وَلَمْ","And not","walam"],["أَدْرِ","I had known","adri"],["مَا","what","mā"],["حِسَابِيَهْ","(is) my account","ḥisābiyah"]],[["يَـٰلَيْتَهَا","O! I wish it","yālaytahā"],["كَانَتِ","had been","kānati"],["ٱلْقَاضِيَةَ","the end","l-qāḍiyata"]],[["مَآ","Not","mā"],["أَغْنَىٰ","has availed","aghnā"],["عَنِّى","me","ʿannī"],["مَالِيَهْ ۜ","my wealth","māliyah"]],[["هَلَكَ","Is gone","halaka"],["عَنِّى","from me","ʿannī"],["سُلْطَـٰنِيَهْ","my authority","sul'ṭāniyah"]],[["خُذُوهُ","Seize him","khudhūhu"],["فَغُلُّوهُ","and shackle him","faghullūhu"]],[["ثُمَّ","Then","thumma"],["ٱلْجَحِيمَ","(into) the Hellfire","l-jaḥīma"],["صَلُّوهُ","burn him","ṣallūhu"]],[["ثُمَّ","Then","thumma"],["فِى","into","fī"],["سِلْسِلَةٍ","a chain","sil'silatin"],["ذَرْعُهَا","its length","dharʿuhā"],["سَبْعُونَ","(is) seventy","sabʿūna"],["ذِرَاعًا","cubits","dhirāʿan"],["فَٱسْلُكُوهُ","insert him","fa-us'lukūhu"]],[["إِنَّهُۥ","Indeed, he","innahu"],["كَانَ","was","kāna"],["لَا","not","lā"],["يُؤْمِنُ","believing","yu'minu"],["بِٱللَّهِ","in Allah","bil-lahi"],["ٱلْعَظِيمِ","the Most Great","l-ʿaẓīmi"]],[["وَلَا","And (did) not","walā"],["يَحُضُّ","feel the urge","yaḥuḍḍu"],["عَلَىٰ","on","ʿalā"],["طَعَامِ","(the) feeding","ṭaʿāmi"],["ٱلْمِسْكِينِ","(of) the poor","l-mis'kīni"]],[["فَلَيْسَ","So not","falaysa"],["لَهُ","for him","lahu"],["ٱلْيَوْمَ","today","l-yawma"],["هَـٰهُنَا","here","hāhunā"],["حَمِيمٌ","any devoted friend","ḥamīmun"]],[["وَلَا","And not","walā"],["طَعَامٌ","any food","ṭaʿāmun"],["إِلَّا","except","illā"],["مِنْ","from","min"],["غِسْلِينٍ","(the) discharge of wounds","ghis'līnin"]],[["لَّا","Not","lā"],["يَأْكُلُهُۥٓ","will eat it","yakuluhu"],["إِلَّا","except","illā"],["ٱلْخَـٰطِـُٔونَ","the sinners","l-khāṭiūna"]],[["فَلَآ","But nay","falā"],["أُقْسِمُ","I swear","uq'simu"],["بِمَا","by what","bimā"],["تُبْصِرُونَ","you see","tub'ṣirūna"]],[["وَمَا","And what","wamā"],["لَا","not","lā"],["تُبْصِرُونَ","you see","tub'ṣirūna"]],[["إِنَّهُۥ","Indeed, it (is)","innahu"],["لَقَوْلُ","surely (the) Word","laqawlu"],["رَسُولٍ","(of) a Messenger","rasūlin"],["كَرِيمٍ","noble","karīmin"]],[["وَمَا","And not","wamā"],["هُوَ","it","huwa"],["بِقَوْلِ","(is the) word","biqawli"],["شَاعِرٍ ۚ","(of) a poet","shāʿirin"],["قَلِيلًا","little","qalīlan"],["مَّا","(is) what","mā"],["تُؤْمِنُونَ","you believe","tu'minūna"]],[["وَلَا","And not","walā"],["بِقَوْلِ","(it is the) word","biqawli"],["كَاهِنٍ ۚ","(of) a soothsayer","kāhinin"],["قَلِيلًا","little","qalīlan"],["مَّا","(is) what","mā"],["تَذَكَّرُونَ","you take heed","tadhakkarūna"]],[["تَنزِيلٌ","(It is) a revelation","tanzīlun"],["مِّن","from","min"],["رَّبِّ","(the) Lord","rabbi"],["ٱلْعَـٰلَمِينَ","(of) the worlds","l-ʿālamīna"]],[["وَلَوْ","And if","walaw"],["تَقَوَّلَ","he (had) fabricated","taqawwala"],["عَلَيْنَا","against Us","ʿalaynā"],["بَعْضَ","some","baʿḍa"],["ٱلْأَقَاوِيلِ","sayings","l-aqāwīli"]],[["لَأَخَذْنَا","Certainly We (would) have seized","la-akhadhnā"],["مِنْهُ","him","min'hu"],["بِٱلْيَمِينِ","by the right hand","bil-yamīni"]],[["ثُمَّ","Then","thumma"],["لَقَطَعْنَا","certainly We (would) have cut off","laqaṭaʿnā"],["مِنْهُ","from him","min'hu"],["ٱلْوَتِينَ","the aorta","l-watīna"]],[["فَمَا","And not","famā"],["مِنكُم","from you","minkum"],["مِّنْ","any","min"],["أَحَدٍ","one","aḥadin"],["عَنْهُ","[from him]","ʿanhu"],["حَـٰجِزِينَ","(who could) prevent (it)","ḥājizīna"]],[["وَإِنَّهُۥ","And indeed, it","wa-innahu"],["لَتَذْكِرَةٌ","(is) surely a reminder","latadhkiratun"],["لِّلْمُتَّقِينَ","for the Allah-fearing","lil'muttaqīna"]],[["وَإِنَّا","And indeed, We","wa-innā"],["لَنَعْلَمُ","surely know","lanaʿlamu"],["أَنَّ","that","anna"],["مِنكُم","among you","minkum"],["مُّكَذِّبِينَ","(are) deniers","mukadhibīna"]],[["وَإِنَّهُۥ","And indeed, it","wa-innahu"],["لَحَسْرَةٌ","(is) surely a regret","laḥasratun"],["عَلَى","upon","ʿalā"],["ٱلْكَـٰفِرِينَ","the disbelievers","l-kāfirīna"]],[["وَإِنَّهُۥ","And indeed, it (is)","wa-innahu"],["لَحَقُّ","surely (the) truth","laḥaqqu"],["ٱلْيَقِينِ","(of) certainty","l-yaqīni"]],[["فَسَبِّحْ","So glorify","fasabbiḥ"],["بِٱسْمِ","(the) name","bi-is'mi"],["رَبِّكَ","(of) your Lord","rabbika"],["ٱلْعَظِيمِ","the Most Great","l-ʿaẓīmi"]]]}