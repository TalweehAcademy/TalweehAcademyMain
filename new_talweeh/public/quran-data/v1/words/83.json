aylun"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["لِّلْمُكَذِّبِينَ","to the deniers","lil'mukadhibīna"]],[["ٱلَّذِينَ","Those who","alladhīna"],["يُكَذِّبُونَ","deny","yukadhibūna"],["بِيَوْمِ","(the) Day","biyawmi"],["ٱلدِّينِ","(of) the Judgment","l-dīni"]],[["وَمَا","And not","wamā"],["يُكَذِّبُ","can deny","yukadhibu"],["بِهِۦٓ","[of] it","bihi"],["إِلَّا","except","illā"],["كُلُّ","every","kullu"],["مُعْتَدٍ","transgressor","muʿ'tadin"],["أَثِيمٍ","sinful","athīmin"]],[["إِذَا","When","idhā"],["تُتْلَىٰ","are recited","tut'lā"],["عَلَيْهِ","to him","ʿalayhi"],["ءَايَـٰتُنَا","Our Verses","āyātunā"],["قَالَ","he says","qāla"],["أَسَـٰطِيرُ","Stories","asāṭīru"],["ٱلْأَوَّلِينَ","(of) the former (people)","l-awalīna"]],[["كَلَّا ۖ","Nay","kallā"],["بَلْ ۜ","But","bal"],["رَانَ","(the) stain has covered","rāna"],["عَلَىٰ","[over]","ʿalā"],["قُلُوبِهِم","their hearts","qulūbihim"],["مَّا","(for) what","mā"],["كَانُوا۟","they used to","kānū"],["يَكْسِبُونَ","earn","yaksibūna"]],[["كَلَّآ","Nay","kallā"],["إِنَّهُمْ","Indeed, they","innahum"],["عَن","from","ʿan"],["رَّبِّهِمْ","their Lord","rabbihim"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["لَّمَحْجُوبُونَ","surely will be partitioned","lamaḥjūbūna"]],[["ثُمَّ","Then","thumma"],["إِنَّهُمْ","indeed, they","innahum"],["لَصَالُوا۟","(surely) will burn","laṣālū"],["ٱلْجَحِيمِ","(in) the Hellfire","l-jaḥīmi"]],[["ثُمَّ","Then","thumma"],["يُقَالُ","it will be said","yuqālu"],["هَـٰذَا","This","hādhā"],["ٱلَّذِى","(is) what","alladhī"],["كُنتُم","you used to","kuntum"],["بِهِۦ","[of it]","bihi"],["تُكَذِّبُونَ","deny","tukadhibūna"]],[["كَلَّآ","Nay","kallā"],["إِنَّ","Indeed","inna"],["كِتَـٰبَ","(the) record","kitāba"],["ٱلْأَبْرَارِ","(of) the righteous","l-abrāri"],["لَفِى","(will be) surely in","lafī"],["عِلِّيِّينَ","Illiyin","ʿilliyyīna"]],[["وَمَآ","And what","wamā"],["أَدْرَىٰكَ","can make you know","adrāka"],["مَا","what","mā"],["عِلِّيُّونَ","(is) Illiyun","ʿilliyyūna"]],[["كِتَـٰبٌ","A book","kitābun"],["مَّرْقُومٌ","written","marqūmun"]],[["يَشْهَدُهُ","Witness it","yashhaduhu"],["ٱلْمُقَرَّبُونَ","those brought near","l-muqarabūna"]],[["إِنَّ","Indeed","inna"],["ٱلْأَبْرَارَ","the righteous","l-abrāra"],["لَفِى","(will be) surely in","lafī"],["نَعِيمٍ","bliss","naʿīmin"]],[["عَلَى","On","ʿalā"],["ٱلْأَرَآئِكِ","thrones","l-arāiki"],["يَنظُرُونَ","observing","yanẓurūna"]],[["تَعْرِفُ","You will recognize","taʿrifu"],["فِى","in","fī"],["وُجُوهِهِمْ","their faces","wujūhihim"],["نَضْرَةَ","(the) radiance","naḍrata"],["ٱلنَّعِيمِ","(of) bliss","l-naʿīmi"]],[["يُسْقَوْنَ","They will be given to drink","yus'qawna"],["مِن","of","min"],["رَّحِيقٍ","a pure wine","raḥīqin"],["مَّخْتُومٍ","sealed","makhtūmin"]],[["خِتَـٰمُهُۥ","Its seal","khitāmuhu"],["مِسْكٌ ۚ","(will be of) musk","mis'kun"],["وَفِى","And for","wafī"],["ذَٰلِكَ","that","dhālika"],["فَلْيَتَنَافَسِ","let aspire","falyatanāfasi"],["ٱلْمُتَنَـٰفِسُونَ","the aspirers","l-mutanāfisūna"]],[["وَمِزَاجُهُۥ","And its mixture","wamizājuhu"],["مِن","(is) of","min"],["تَسْنِيمٍ","Tasneem","tasnīmin"]],[["عَيْنًا","A spring","ʿaynan"],["يَشْرَبُ","will drink","yashrabu"],["بِهَا","from it","bihā"],["ٱلْمُقَرَّبُونَ","those brought near","l-muqarabūna"]],[["إِنَّ","Indeed","inna"],["ٱلَّذِينَ","those who","alladhīna"],["أَجْرَمُوا۟","committed crimes","ajramū"],["كَانُوا۟","used to","kānū"],["مِنَ","at","mina"],["ٱلَّذِينَ","those who","alladhīna"],["ءَامَنُوا۟","believed","āmanū"],["يَضْحَكُونَ","laugh","yaḍḥakūna"]],[["وَإِذَا","And when","wa-idhā"],["مَرُّوا۟","they passed","marrū"],["بِهِمْ","by them","bihim"],["يَتَغَامَزُونَ","they winked at one another","yataghāmazūna"]],[["وَإِذَا","And when","wa-idhā"],["ٱنقَلَبُوٓا۟","they returned","inqalabū"],["إِلَىٰٓ","to","ilā"],["أَهْلِهِمُ","their people","ahlihimu"],["ٱنقَلَبُوا۟","they would return","inqalabū"],["فَكِهِينَ","jesting","fakihīna"]],[["وَإِذَا","And when","wa-idhā"],["رَأَوْهُمْ","they saw them","ra-awhum"],["قَالُوٓا۟","they said","qālū"],["إِنَّ","Indeed","inna"],["هَـٰٓؤُلَآءِ","these","hāulāi"],["لَضَآلُّونَ","surely have gone astray","laḍāllūna"]],[["وَمَآ","But not","wamā"],["أُرْسِلُوا۟","they had been sent","ur'silū"],["عَلَيْهِمْ","over them","ʿalayhim"],["حَـٰفِظِينَ","(as) guardians","ḥāfiẓīna"]],[["فَٱلْيَوْمَ","So today","fal-yawma"],["ٱلَّذِينَ","those who","alladhīna"],["ءَامَنُوا۟","believed ","āmanū"],["مِنَ","at","mina"],["ٱلْكُفَّارِ","the disbelievers","l-kufāri"],["يَضْحَكُونَ","they will laugh","yaḍḥakūna"]],[["عَلَى","On","ʿalā"],["ٱلْأَرَآئِكِ","the thrones","l-arāiki"],["يَنظُرُونَ","observing","yanẓurūna"]],[["هَلْ","Have (not)","hal"],["ثُوِّبَ","been rewarded","thuwwiba"],["ٱلْكُفَّارُ","the disbelievers","l-kufāru"],["مَا","(for) what","mā"],["كَانُوا۟","they used to","kānū"],["يَفْعَلُونَ","do","yafʿalūna"]]]}