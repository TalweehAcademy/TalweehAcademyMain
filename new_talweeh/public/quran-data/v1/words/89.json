,"And (made) much","fa-aktharū"],["فِيهَا","therein","fīhā"],["ٱلْفَسَادَ","corruption","l-fasāda"]],[["فَصَبَّ","So poured","faṣabba"],["عَلَيْهِمْ","on them","ʿalayhim"],["رَبُّكَ","your Lord","rabbuka"],["سَوْطَ","scourge","sawṭa"],["عَذَابٍ","(of) punishment","ʿadhābin"]],[["إِنَّ","Indeed","inna"],["رَبَّكَ","your Lord","rabbaka"],["لَبِٱلْمِرْصَادِ","(is) surely Ever Watchful","labil-mir'ṣādi"]],[["فَأَمَّا","And as for","fa-ammā"],["ٱلْإِنسَـٰنُ","man","l-insānu"],["إِذَا","when","idhā"],["مَا","does","mā"],["ٱبْتَلَىٰهُ","try him","ib'talāhu"],["رَبُّهُۥ","his Lord","rabbuhu"],["فَأَكْرَمَهُۥ","and is generous to him","fa-akramahu"],["وَنَعَّمَهُۥ","and favors him","wanaʿʿamahu"],["فَيَقُولُ","he says","fayaqūlu"],["رَبِّىٓ","My Lord","rabbī"],["أَكْرَمَنِ","has honored me","akramani"]],[["وَأَمَّآ","But","wa-ammā"],["إِذَا","when","idhā"],["مَا","does","mā"],["ٱبْتَلَىٰهُ","He try him","ib'talāhu"],["فَقَدَرَ","and restricts","faqadara"],["عَلَيْهِ","for him","ʿalayhi"],["رِزْقَهُۥ","his provision","riz'qahu"],["فَيَقُولُ","then he says","fayaqūlu"],["رَبِّىٓ","My Lord","rabbī"],["أَهَـٰنَنِ","(has) humiliated me","ahānani"]],[["كَلَّا ۖ","Nay","kallā"],["بَل","But","bal"],["لَّا","not","lā"],["تُكْرِمُونَ","you honor","tuk'rimūna"],["ٱلْيَتِيمَ","the orphan","l-yatīma"]],[["وَلَا","And not","walā"],["تَحَـٰٓضُّونَ","you feel the urge","taḥāḍḍūna"],["عَلَىٰ","to","ʿalā"],["طَعَامِ","feed","ṭaʿāmi"],["ٱلْمِسْكِينِ","the poor","l-mis'kīni"]],[["وَتَأْكُلُونَ","And you consume","watakulūna"],["ٱلتُّرَاثَ","the inheritance","l-turātha"],["أَكْلًا","devouring","aklan"],["لَّمًّا","altogether","lamman"]],[["وَتُحِبُّونَ","And you love","watuḥibbūna"],["ٱلْمَالَ","wealth","l-māla"],["حُبًّا","(with) love","ḥubban"],["جَمًّا","immense","jamman"]],[["كَلَّآ","Nay","kallā"],["إِذَا","When","idhā"],["دُكَّتِ","is leveled","dukkati"],["ٱلْأَرْضُ","the earth","l-arḍu"],["دَكًّا","pounded","dakkan"],["دَكًّا","(and) crushed","dakkan"]],[["وَجَآءَ","And comes","wajāa"],["رَبُّكَ","your Lord","rabbuka"],["وَٱلْمَلَكُ","and the Angels","wal-malaku"],["صَفًّا","rank","ṣaffan"],["صَفًّا","(upon) rank","ṣaffan"]],[["وَجِا۟ىٓءَ","And is brought","wajīa"],["يَوْمَئِذٍۭ","that Day","yawma-idhin"],["بِجَهَنَّمَ ۚ","Hell","bijahannama"],["يَوْمَئِذٍ","That Day","yawma-idhin"],["يَتَذَكَّرُ","will remember","yatadhakkaru"],["ٱلْإِنسَـٰنُ","man","l-insānu"],["وَأَنَّىٰ","but how","wa-annā"],["لَهُ","(will be) for him","lahu"],["ٱلذِّكْرَىٰ","the remembrance","l-dhik'rā"]],[["يَقُولُ","He will say","yaqūlu"],["يَـٰلَيْتَنِى","O I wish","yālaytanī"],["قَدَّمْتُ","I had sent forth","qaddamtu"],["لِحَيَاتِى","for my life","liḥayātī"]],[["فَيَوْمَئِذٍ","So that Day","fayawma-idhin"],["لَّا","not","lā"],["يُعَذِّبُ","will punish","yuʿadhibu"],["عَذَابَهُۥٓ","(as) His punishment","ʿadhābahu"],["أَحَدٌ","anyone","aḥadun"]],[["وَلَا","And not","walā"],["يُوثِقُ","will bind","yūthiqu"],["وَثَاقَهُۥٓ","(as) His binding","wathāqahu"],["أَحَدٌ","anyone","aḥadun"]],[["يَـٰٓأَيَّتُهَا","O","yāayyatuhā"],["ٱلنَّفْسُ","soul","l-nafsu"],["ٱلْمُطْمَئِنَّةُ","who is satisfied","l-muṭ'ma-inatu"]],[["ٱرْجِعِىٓ","Return","ir'jiʿī"],["إِلَىٰ","to","ilā"],["رَبِّكِ","your Lord","rabbiki"],["رَاضِيَةً","well pleased","rāḍiyatan"],["مَّرْضِيَّةً","and pleasing","marḍiyyatan"]],[["فَٱدْخُلِى","So enter","fa-ud'khulī"],["فِى","among","fī"],["عِبَـٰدِى","My slaves","ʿibādī"]],[["وَٱدْخُلِى","And enter","wa-ud'khulī"],["جَنَّتِى","My Paradise","jannatī"]]]}