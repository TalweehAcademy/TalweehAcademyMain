 not","walā"],["يَسْـَٔلُ","will ask","yasalu"],["حَمِيمٌ","a friend","ḥamīmun"],["حَمِيمًا","(about) a friend","ḥamīman"]],[["يُبَصَّرُونَهُمْ ۚ","They will be made to see each other","yubaṣṣarūnahum"],["يَوَدُّ","Would wish","yawaddu"],["ٱلْمُجْرِمُ","the criminal","l-muj'rimu"],["لَوْ","if","law"],["يَفْتَدِى","he (could be) ransomed","yaftadī"],["مِنْ","from","min"],["عَذَابِ","(the) punishment","ʿadhābi"],["يَوْمِئِذٍۭ","(of) that Day","yawmi-idhin"],["بِبَنِيهِ","by his children","bibanīhi"]],[["وَصَـٰحِبَتِهِۦ","And his spouse","waṣāḥibatihi"],["وَأَخِيهِ","and his brother","wa-akhīhi"]],[["وَفَصِيلَتِهِ","And his nearest kindred","wafaṣīlatihi"],["ٱلَّتِى","who","allatī"],["تُـْٔوِيهِ","sheltered him","tu'wīhi"]],[["وَمَن","And whoever","waman"],["فِى","(is) on","fī"],["ٱلْأَرْضِ","the earth","l-arḍi"],["جَمِيعًا","all","jamīʿan"],["ثُمَّ","then","thumma"],["يُنجِيهِ","it (could) save him","yunjīhi"]],[["كَلَّآ ۖ","By no means","kallā"],["إِنَّهَا","Indeed, it (is)","innahā"],["لَظَىٰ","surely a Flame of Hell","laẓā"]],[["نَزَّاعَةً","A remover","nazzāʿatan"],["لِّلشَّوَىٰ","of the skin of the head","lilshawā"]],[["تَدْعُوا۟","Inviting","tadʿū"],["مَنْ","(him) who","man"],["أَدْبَرَ","turned his back","adbara"],["وَتَوَلَّىٰ","and went away","watawallā"]],[["وَجَمَعَ","And collected","wajamaʿa"],["فَأَوْعَىٰٓ","and hoarded","fa-awʿā"]],[["۞ إِنَّ","Indeed","inna"],["ٱلْإِنسَـٰنَ","the man","l-insāna"],["خُلِقَ","was created","khuliqa"],["هَلُوعًا","anxious ","halūʿan"]],[["إِذَا","When","idhā"],["مَسَّهُ","touches him","massahu"],["ٱلشَّرُّ","the evil","l-sharu"],["جَزُوعًا","distressed","jazūʿan"]],[["وَإِذَا","And when","wa-idhā"],["مَسَّهُ","touches him","massahu"],["ٱلْخَيْرُ","the good","l-khayru"],["مَنُوعًا","withholding","manūʿan"]],[["إِلَّا","Except","illā"],["ٱلْمُصَلِّينَ","those who pray ","l-muṣalīna"]],[["ٱلَّذِينَ","Those who","alladhīna"],["هُمْ","[they]","hum"],["عَلَىٰ","at","ʿalā"],["صَلَاتِهِمْ","their prayer","ṣalātihim"],["دَآئِمُونَ","(are) constant","dāimūna"]],[["وَٱلَّذِينَ","And those who","wa-alladhīna"],["فِىٓ","in","fī"],["أَمْوَٰلِهِمْ","their wealth","amwālihim"],["حَقٌّ","(is) a right","ḥaqqun"],["مَّعْلُومٌ","known","maʿlūmun"]],[["لِّلسَّآئِلِ","For the one who asks","lilssāili"],["وَٱلْمَحْرُومِ","and the deprived","wal-maḥrūmi"]],[["وَٱلَّذِينَ","And those who","wa-alladhīna"],["يُصَدِّقُونَ","accept (the) truth","yuṣaddiqūna"],["بِيَوْمِ","(of the) Day","biyawmi"],["ٱلدِّينِ","(of) the Judgment","l-dīni"]],[["وَٱلَّذِينَ","And those who","wa-alladhīna"],["هُم","[they]","hum"],["مِّنْ","of","min"],["عَذَابِ","(the) punishment","ʿadhābi"],["رَبِّهِم","(of) their Lord","rabbihim"],["مُّشْفِقُونَ","(are) fearful ","mush'fiqūna"]],[["إِنَّ","Indeed","inna"],["عَذَابَ","(the) punishment","ʿadhāba"],["رَبِّهِمْ","(of) your Lord","rabbihim"],["غَيْرُ","(is) not","ghayru"],["مَأْمُونٍ","to be felt secure (of) ","mamūnin"]],[["وَٱلَّذِينَ","And those who","wa-alladhīna"],["هُمْ","[they]","hum"],["لِفُرُوجِهِمْ","their modesty","lifurūjihim"],["حَـٰفِظُونَ","(are) guardians","ḥāfiẓūna"]],[["إِلَّا","Except","illā"],["عَلَىٰٓ","from","ʿalā"],["أَزْوَٰجِهِمْ","their spouses","azwājihim"],["أَوْ","or","aw"],["مَا","what","mā"],["مَلَكَتْ","they possess","malakat"],["أَيْمَـٰنُهُمْ","rightfully","aymānuhum"],["فَإِنَّهُمْ","then indeed, they","fa-innahum"],["غَيْرُ","(are) not","ghayru"],["مَلُومِينَ","blameworthy","malūmīna"]],[["فَمَنِ","But whoever","famani"],["ٱبْتَغَىٰ","seeks","ib'taghā"],["وَرَآءَ","beyond","warāa"],["ذَٰلِكَ","that","dhālika"],["فَأُو۟لَـٰٓئِكَ","then those","fa-ulāika"],["هُمُ","[they]","humu"],["ٱلْعَادُونَ","(are) the transgressors ","l-ʿādūna"]],[["وَٱلَّذِينَ","And those who","wa-alladhīna"],["هُمْ","[they]","hum"],["لِأَمَـٰنَـٰتِهِمْ","of their trusts","li-amānātihim"],["وَعَهْدِهِمْ","and their promise","waʿahdihim"],["رَٰعُونَ","(are) observers","rāʿūna"]],[["وَٱلَّذِينَ","And those who","wa-alladhīna"],["هُم","[they]","hum"],["بِشَهَـٰدَٰتِهِمْ","in their testimonies","bishahādātihim"],["قَآئِمُونَ","stand firm","qāimūna"]],[["وَٱلَّذِينَ","And those who","wa-alladhīna"],["هُمْ","[they]","hum"],["عَلَىٰ","on","ʿalā"],["صَلَاتِهِمْ","their prayer","ṣalātihim"],["يُحَافِظُونَ","keep a guard ","yuḥāfiẓūna"]],[["أُو۟لَـٰٓئِكَ","Those","ulāika"],["فِى","(will be) in","fī"],["جَنَّـٰتٍ","Gardens","jannātin"],["مُّكْرَمُونَ","honored","muk'ramūna"]],[["فَمَالِ","So what is with","famāli"],["ٱلَّذِينَ","those who","alladhīna"],["كَفَرُوا۟","disbelieve","kafarū"],["قِبَلَكَ","before you","qibalaka"],["مُهْطِعِينَ","(they) hasten","muh'ṭiʿīna"]],[["عَنِ","On","ʿani"],["ٱلْيَمِينِ","the right","l-yamīni"],["وَعَنِ","and on","waʿani"],["ٱلشِّمَالِ","the left","l-shimāli"],["عِزِينَ","(in) separate groups","ʿizīna"]],[["أَيَطْمَعُ","Does long","ayaṭmaʿu"],["كُلُّ","every","kullu"],["ٱمْرِئٍ","person","im'ri-in"],["مِّنْهُمْ","among them","min'hum"],["أَن","that","an"],["يُدْخَلَ","he enters","yud'khala"],["جَنَّةَ","a Garden","jannata"],["نَعِيمٍ","(of) Delight","naʿīmin"]],[["كَلَّآ ۖ","By no means","kallā"],["إِنَّا","Indeed, We","innā"],["خَلَقْنَـٰهُم","[We] have created them","khalaqnāhum"],["مِّمَّا","from what","mimmā"],["يَعْلَمُونَ","they know","yaʿlamūna"]],[["فَلَآ","But nay","falā"],["أُقْسِمُ","I swear","uq'simu"],["بِرَبِّ","by (the) Lord","birabbi"],["ٱلْمَشَـٰرِقِ","(of) the risings","l-mashāriqi"],["وَٱلْمَغَـٰرِبِ","and the settings","wal-maghāribi"],["إِنَّا","that We","innā"],["لَقَـٰدِرُونَ","(are) surely Able","laqādirūna"]],[["عَلَىٰٓ","[On]","ʿalā"],["أَن","to","an"],["نُّبَدِّلَ","[We] replace","nubaddila"],["خَيْرًا","(with) better","khayran"],["مِّنْهُمْ","than them","min'hum"],["وَمَا","and not","wamā"],["نَحْنُ","We","naḥnu"],["بِمَسْبُوقِينَ","(are) to be outrun","bimasbūqīna"]],[["فَذَرْهُمْ","So leave them","fadharhum"],["يَخُوضُوا۟","(to) converse vainly","yakhūḍū"],["وَيَلْعَبُوا۟","and amuse themselves","wayalʿabū"],["حَتَّىٰ","until","ḥattā"],["يُلَـٰقُوا۟","they meet","yulāqū"],["يَوْمَهُمُ","their Day","yawmahumu"],["ٱلَّذِى","which","alladhī"],["يُوعَدُونَ","they are promised","yūʿadūna"]],[["يَوْمَ","(The) Day","yawma"],["يَخْرُجُونَ","they will come out","yakhrujūna"],["مِنَ","from","mina"],["ٱلْأَجْدَاثِ","the graves","l-ajdāthi"],["سِرَاعًا","rapidly","sirāʿan"],["كَأَنَّهُمْ","as if they (were)","ka-annahum"],["إِلَىٰ","to","ilā"],["نُصُبٍ","a goal","nuṣubin"],["يُوفِضُونَ","hastening","yūfiḍūna"]],[["خَـٰشِعَةً","Humbled","khāshiʿatan"],["أَبْصَـٰرُهُمْ","their eyesights","abṣāruhum"],["تَرْهَقُهُمْ","will cover them","tarhaquhum"],["ذِلَّةٌ ۚ","humiliation","dhillatun"],["ذَٰلِكَ","That","dhālika"],["ٱلْيَوْمُ","(is) the Day","l-yawmu"],["ٱلَّذِى","which","alladhī"],["كَانُوا۟","they were","kānū"],["يُوعَدُونَ","promised","yūʿadūna"]]]}