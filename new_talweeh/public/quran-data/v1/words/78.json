َّیْلَ"],["لِبَاسًا","(as) covering","libāsan","لِبَاسًا"]],[["وَجَعَلْنَا","And We made","wajaʿalnā","وَّجَعَلْنَا"],["ٱلنَّهَارَ","the day","l-nahāra","النَّهَارَ"],["مَعَاشًا","(for) livelihood","maʿāshan","مَعَاشًا"]],[["وَبَنَيْنَا","And We constructed","wabanaynā","وَّبَنَیْنَا"],["فَوْقَكُمْ","over you","fawqakum","فَوْقَكُمْ"],["سَبْعًا","seven","sabʿan","سَبْعًا"],["شِدَادًا","strong","shidādan","شِدَادًا"]],[["وَجَعَلْنَا","And We placed","wajaʿalnā","وَّجَعَلْنَا"],["سِرَاجًا","a lamp","sirājan","سِرَاجًا"],["وَهَّاجًا","burning","wahhājan","وَّهَّاجًا"]],[["وَأَنزَلْنَا","And We sent down","wa-anzalnā","وَّاَنْزَلْنَا"],["مِنَ","from","mina","مِنَ"],["ٱلْمُعْصِرَٰتِ","the rain clouds","l-muʿ'ṣirāti","الْمُعْصِرٰتِ"],["مَآءً","water","māan","مَآءً"],["ثَجَّاجًا","pouring abundantly","thajjājan","ثَجَّاجًا"]],[["لِّنُخْرِجَ","That We may bring forth","linukh'rija","لِّنُخْرِجَ"],["بِهِۦ","thereby","bihi","بِهٖ"],["حَبًّا","grain","ḥabban","حَبًّا"],["وَنَبَاتًا","and vegetation","wanabātan","وَّنَبَاتًا"]],[["وَجَنَّـٰتٍ","And gardens","wajannātin","وَّجَنّٰتٍ"],["أَلْفَافًا","(of) thick foliage","alfāfan","اَلْفَافًا"]],[["إِنَّ","Indeed","inna","اِنَّ"],["يَوْمَ","(the) Day","yawma","یَوْمَ"],["ٱلْفَصْلِ","(of) the Judgment","l-faṣli","الْفَصْلِ"],["كَانَ","is","kāna","كَانَ"],["مِيقَـٰتًا","an appointed time","mīqātan","مِیْقَاتًا"]],[["يَوْمَ","(The) Day","yawma","یَّوْمَ"],["يُنفَخُ","(in which) shall be blown","yunfakhu","یُنْفَخُ"],["فِى","in","fī","فِی"],["ٱلصُّورِ","the trumpet","l-ṣūri","الصُّوْرِ"],["فَتَأْتُونَ","and you will come forth","fatatūna","فَتَاْتُوْنَ"],["أَفْوَاجًا","(in) crowds","afwājan","اَفْوَاجًا"]],[["وَفُتِحَتِ","And is opened","wafutiḥati","وَّفُتِحَتِ"],["ٱلسَّمَآءُ","the heaven","l-samāu","السَّمَآءُ"],["فَكَانَتْ","and becomes","fakānat","فَكَانَتْ"],["أَبْوَٰبًا","gateways","abwāban","اَبْوَابًا"]],[["وَسُيِّرَتِ","And are moved","wasuyyirati","وَّسُیِّرَتِ"],["ٱلْجِبَالُ","the mountains","l-jibālu","الْجِبَالُ"],["ف