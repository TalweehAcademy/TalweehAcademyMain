In","fī"],["صُحُفٍ","sheets","ṣuḥufin"],["مُّكَرَّمَةٍ","honored","mukarramatin"]],[["مَّرْفُوعَةٍ","Exalted","marfūʿatin"],["مُّطَهَّرَةٍۭ","purified","muṭahharatin"]],[["بِأَيْدِى","In (the) hands","bi-aydī"],["سَفَرَةٍ","(of) scribes","safaratin"]],[["كِرَامٍۭ","Noble","kirāmin"],["بَرَرَةٍ","dutiful","bararatin"]],[["قُتِلَ","Is destroyed","qutila"],["ٱلْإِنسَـٰنُ","[the] man","l-insānu"],["مَآ","how","mā"],["أَكْفَرَهُۥ","ungrateful is he","akfarahu"]],[["مِنْ","From","min"],["أَىِّ","what","ayyi"],["شَىْءٍ","thing","shayin"],["خَلَقَهُۥ","He created him","khalaqahu"]],[["مِن","From","min"],["نُّطْفَةٍ","a semen-drop","nuṭ'fatin"],["خَلَقَهُۥ","He created him","khalaqahu"],["فَقَدَّرَهُۥ","then He proportioned him","faqaddarahu"]],[["ثُمَّ","Then","thumma"],["ٱلسَّبِيلَ","the way","l-sabīla"],["يَسَّرَهُۥ","He made easy for him","yassarahu"]],[["ثُمَّ","Then","thumma"],["أَمَاتَهُۥ","He causes him to die","amātahu"],["فَأَقْبَرَهُۥ","and provides a grave for him","fa-aqbarahu"]],[["ثُمَّ","Then","thumma"],["إِذَا","when","idhā"],["شَآءَ","He wills","shāa"],["أَنشَرَهُۥ","He will resurrect him","ansharahu"]],[["كَلَّا","Nay","kallā"],["لَمَّا","Not","lammā"],["يَقْضِ","he has accomplished","yaqḍi"],["مَآ","what","mā"],["أَمَرَهُۥ","He commanded him","amarahu"]],[["فَلْيَنظُرِ","Then let look","falyanẓuri"],["ٱلْإِنسَـٰنُ","the man","l-insānu"],["إِلَىٰ","at","ilā"],["طَعَامِهِۦٓ","his food","ṭaʿāmihi"]],[["أَنَّا","That [We]","annā"],["صَبَبْنَا","[We] poured","ṣababnā"],["ٱلْمَآءَ","the water","l-māa"],["صَبًّا","(in) abundance","ṣabban"]],[["ثُمَّ","Then","thumma"],["شَقَقْنَا","We cleaved","shaqaqnā"],["ٱلْأَرْضَ","the earth","l-arḍa"],["شَقًّا","splitting","shaqqan"]],[["فَأَنۢبَتْنَا","Then We caused to grow","fa-anbatnā"],["فِيهَا","therein","fīhā"],["حَبًّا","grain","ḥabban"]],[["وَعِنَبًا","And grapes","waʿinaban"],["وَقَضْبًا","and green fodder","waqaḍban"]],[["وَزَيْتُونًا","And olive","wazaytūnan"],["وَنَخْلًا","and date-palms","wanakhlan"]],[["وَحَدَآئِقَ","And gardens","waḥadāiqa"],["غُلْبًا","(of) thick foliage","ghul'ban"]],[["وَفَـٰكِهَةً","And fruits","wafākihatan"],["وَأَبًّا","and grass","wa-abban"]],[["مَّتَـٰعًا","(As) a provision","matāʿan"],["لَّكُمْ","for you","lakum"],["وَلِأَنْعَـٰمِكُمْ","and for your cattle","wali-anʿāmikum"]],[["فَإِذَا","But when","fa-idhā"],["جَآءَتِ","comes","jāati"],["ٱلصَّآخَّةُ","the Deafening Blast","l-ṣākhatu"]],[["يَوْمَ","(The) Day","yawma"],["يَفِرُّ","will flee","yafirru"],["ٱلْمَرْءُ","a man","l-maru"],["مِنْ","from","min"],["أَخِيهِ","his brother","akhīhi"]],[["وَأُمِّهِۦ","And his mother","wa-ummihi"],["وَأَبِيهِ","and his father","wa-abīhi"]],[["وَصَـٰحِبَتِهِۦ","And his wife","waṣāḥibatihi"],["وَبَنِيهِ","and his children","wabanīhi"]],[["لِكُلِّ","For every","likulli"],["ٱمْرِئٍ","man","im'ri-in"],["مِّنْهُمْ","among them","min'hum"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["شَأْنٌ","(will be) a matter","shanun"],["يُغْنِيهِ","occupying him","yugh'nīhi"]],[["وُجُوهٌ","Faces","wujūhun"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["مُّسْفِرَةٌ","(will be) bright","mus'firatun"]],[["ضَاحِكَةٌ","Laughing","ḍāḥikatun"],["مُّسْتَبْشِرَةٌ","rejoicing at good news","mus'tabshiratun"]],[["وَوُجُوهٌ","And faces","wawujūhun"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["عَلَيْهَا","upon them","ʿalayhā"],["غَبَرَةٌ","(will be) dust","ghabaratun"]],[["تَرْهَقُهَا","Will cover them","tarhaquhā"],["قَتَرَةٌ","darkness","qataratun"]],[["أُو۟لَـٰٓئِكَ","Those","ulāika"],["هُمُ","[they]","humu"],["ٱلْكَفَرَةُ","(are) the disbelievers","l-kafaratu"],["ٱلْفَجَرَةُ","the wicked ones","l-fajaratu"]]]}