","l-kabīru","الْكَبِیْرُ"]],[["إِنَّ","Indeed","inna","اِنَّ"],["بَطْشَ","(the) Grip","baṭsha","بَطْشَ"],["رَبِّكَ","(of) your Lord","rabbika","رَبِّكَ"],["لَشَدِيدٌ","(is) surely strong","lashadīdun","لَشَدِیْدٌ"]],[["إِنَّهُۥ","Indeed He","innahu","اِنَّهٗ"],["هُوَ","He","huwa","هُوَ"],["يُبْدِئُ","originates","yub'di-u","یُبْدِئُ"],["وَيُعِيدُ","and repeats","wayuʿīdu","وَیُعِیْدُ"]],[["وَهُوَ","And He","wahuwa","وَهُوَ"],["ٱلْغَفُورُ","(is) the Oft-Forgiving","l-ghafūru","الْغَفُوْرُ"],["ٱلْوَدُودُ","the Most Loving","l-wadūdu","الْوَدُوْدُ"]],[["ذُو","Owner (of)","dhū","ذُو"],["ٱلْعَرْشِ","the Throne","l-ʿarshi","الْعَرْشِ"],["ٱلْمَجِيدُ","the Glorious","l-majīdu","الْمَجِیْدُ"]],[["فَعَّالٌ","Doer","faʿʿālun","فَعَّالٌ"],["لِّمَا","of what","limā","لِّمَا"],["يُرِيدُ","He intends","yurīdu","یُرِیْدُ"]],[["هَلْ","Has","hal","هَلْ"],["أَتَىٰكَ","come to you","atāka","اَتٰىكَ"],["حَدِيثُ","(the) story","ḥadīthu","حَدِیْثُ"],["ٱلْجُنُودِ","(of) the hosts","l-junūdi","الْجُنُوْدِ"]],[["فِرْعَوْنَ","Firaun","fir'ʿawna","فِرْعَوْنَ"],["وَثَمُودَ","and Thamud","wathamūda","وَثَمُوْدَ"]],[["بَلِ","Nay","bali","بَلِ"],["ٱلَّذِينَ","Those who","alladhīna","الَّذِیْنَ"],["كَفَرُوا۟","disbelieve","kafarū","كَفَرُوْا"],["فِى","(are) in","fī","فِیْ"],["تَكْذِيبٍ","denial","takdhībin","تَكْذِیْبٍ"]],[["وَٱللَّهُ","But Allah","wal-lahu","وَّاللّٰهُ"],["مِن","from","min","مِنْ"],["وَرَآئِهِم","behind them","warāihim","وَّرَآىِٕهِمْ"],["مُّحِيطٌۢ","encompasses","muḥīṭun","مُّحِیْطٌ"]],[["بَلْ","Nay","bal","بَلْ"],["هُوَ","It","huwa","هُوَ"],["قُرْءَانٌ","(is) a Quran","qur'ānun","قُرْاٰنٌ"],["مَّجِيدٌ","Glorious","majīdun","مَّجِیْدٌ"]],[["فِى","In","fī","فِیْ"],["لَوْحٍ","a Tablet","lawḥin","لَوْحٍ"],["مَّحْفُوظٍۭ","Guarded","maḥfūẓin","مَّحْفُوْظٍ"]]]}